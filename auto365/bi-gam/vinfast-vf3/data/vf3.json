  "faq": [
    {
      "hoi": "VF3 nên lắp bi gầm loại nào?",
      "dap": "Tuỳ nhu cầu: đi phố ưu tiên vùng sáng gần, đều; hay đi mưa, đường tối nên chọn mẫu có vùng sáng rộng. Kỹ thuật viên kiểm tra hốc đèn gầm của xe trước khi chốt mẫu."
    },
    {
      "hoi": "Chi phí nâng cấp bi gầm VF3 khoảng bao nhiêu?",
      "dap": "Giá bộ đèn tham khảo từ 4.500.000đ đến 6.000.000đ, chưa gồm VAT. Pát/dưỡng, vật tư điện, công lắp và căn chỉnh báo riêng theo từng xe."
    },
    {
      "hoi": "Lắp bi gầm có ảnh hưởng bảo hành xe không?",
      "dap": "Phương án đấu nối được xác nhận sau khi kỹ thuật viên kiểm tra xe. Điều kiện bảo hành của hãng xe nên hỏi lại đại lý VinFast."
    },
    {
      "hoi": "Nhiệt màu nào phù hợp đi phố và đi tỉnh?",
      "dap": "Tuỳ thói quen sử dụng và mẫu đèn. Kỹ thuật viên tư vấn nhiệt màu theo thông số của từng sản phẩm khi kiểm tra xe."
    },
    {
      "hoi": "Có cần thay đổi hệ thống điện khi lắp bi gầm?",
      "dap": "Tuỳ cấu hình và phiên bản xe. Kỹ thuật viên kiểm tra công suất và đường điện trước khi chốt phương án lắp."
    },
    {
      "hoi": "VF3 nên chọn bi gầm hay nâng cấp đèn chính?",
      "dap": "Bi gầm bổ sung ánh sáng vùng gần mặt đường và hai bên lề; đèn chính phục vụ tầm chiếu xa. Nếu nhu cầu thực tế là nhìn xa hơn thì nên cân nhắc nâng cấp đèn chính. Kỹ thuật viên tư vấn sau khi kiểm tra xe."
    },
    {
      "hoi": "Trước khi lắp bi gầm VF3 cần kiểm tra gì?",
      "dap": "Kiểm tra đúng phiên bản/đời xe, vị trí lắp và độ tương thích với cản, công suất và hệ thống điện, và xe đã từng can thiệp hệ thống ánh sáng hay thay mặt dưỡng/cản chưa."
    },
    {
      "hoi": "Có cần thay mặt dưỡng hoặc làm pát không?",
      "dap": "Tuỳ vị trí lắp và cấu hình đã chọn. Chi phí pát/dưỡng được báo riêng theo từng xe sau khi kiểm tra."
    },
    {
      "hoi": "Sau khi lắp cần căn chỉnh thế nào?",
      "dap": "Kiểm tra vị trí đèn, hướng chiếu và vùng sáng, rồi chạy thử để căn chỉnh sao cho hạn chế chói xe đối diện."
    },
    {
      "hoi": "Auto365 đã có VF3 lắp bi gầm thực tế chưa?",
      "dap": "Hiện có video lắp bi gầm GTR G1 Turbo V2 trên VF3 (xem mục video phía trên). Hồ sơ case chi tiết đang được bổ sung khi xác minh đủ ảnh và thông tin."
    },
    {
      "hoi": "Lắp bi gầm có bị lỗi đăng kiểm không?",
      "dap": "Cần căn chỉnh góc chiếu không gây chói và giữ đúng vị trí đèn gầm. Liên hệ để được tư vấn theo quy định hiện hành."
    }
  ],
