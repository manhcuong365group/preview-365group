    {
      "@type": "FAQPage",
      "@id": "https://auto365.vn/nang-cap-anh-sang-bi-gam#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Bi gầm ô tô là gì?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bi gầm là cụm đèn sử dụng thấu kính hội tụ, lắp ở vị trí thấp phía trước xe để bổ sung vùng sáng gần mặt đường. Hiệu quả phụ thuộc cấu hình sản phẩm, vị trí lắp và quá trình căn chỉnh."
          }
        },
        {
          "@type": "Question",
          "name": "Bi gầm 2.0 inch và 3.0 inch khác nhau thế nào?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Khác trước hết ở kích thước lens và không gian lắp đặt. Lens 2.0 inch gọn hơn cho hốc đèn nhỏ; lens 3.0 inch có nhiều lựa chọn hiệu năng cao. Khả năng lắp cần kiểm tra trên đúng xe."
          }
        },
        {
          "@type": "Question",
          "name": "Đi mưa nên chọn 3000K, 4300K hay 5500K?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "3000K cho sắc vàng rõ, 4300K cân bằng và 5500K trắng hơn. Không có một mức luôn tối ưu cho mọi tình huống; cần xem thêm beam pattern, mặt đường và điều kiện sử dụng."
          }
        },
        {
          "@type": "Question",
          "name": "Có nên chọn bi gầm công suất cao nhất?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Không. Công suất không mô tả đầy đủ chất lượng vùng sáng; cần xem cùng đường cắt Cos, độ phủ, độ gom Pha, tản nhiệt, fitment và căn chỉnh."
          }
        },
        {
          "@type": "Question",
          "name": "Làm sao biết xe có lắp vừa bi gầm?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cần kiểm tra đời xe, hốc đèn, mặt dưỡng, kích thước thân đèn, pát/bộ gá, khoảng hở tản nhiệt, dây/giắc và hệ thống điện."
          }
        }
      ]
    }
  ]
