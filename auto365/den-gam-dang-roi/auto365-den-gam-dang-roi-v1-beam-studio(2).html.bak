              <rect x="288" y="184" width="124" height="38" rx="8" fill="#e2e7ee"/>
              <line x1="294" y1="196" x2="406" y2="196"/><line x1="294" y1="206" x2="406" y2="206"/><line x1="294" y1="216" x2="406" y2="216"/>
              <circle cx="350" cy="201" r="9" fill="#f4f6f9"/>
            </g>
            <!-- plate -->
