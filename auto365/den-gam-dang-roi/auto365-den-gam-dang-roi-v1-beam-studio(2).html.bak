              <path d="M118,336 L582,336" stroke="#c9d1da"/>
              <path d="M175,52 L155,110 M525,52 L545,110" />
              <path d="M108,348 Q135,340 162,348 M538,348 Q565,340 592,348" stroke="#c9d1da"/>
            </g>
            <!-- headlights -->
            <g stroke="#8b96a3" stroke-width="1.8" fill="#fdfdfe">
              <path d="M152,186 L268,182 L262,212 L160,217 Z"/>
              <path d="M548,186 L432,182 L438,212 L540,217 Z"/>
              <circle cx="196" cy="199" r="7" fill="#dfe5ec"/><circle cx="222" cy="198" r="7" fill="#dfe5ec"/>
              <circle cx="504" cy="199" r="7" fill="#dfe5ec"/><circle cx="478" cy="198" r="7" fill="#dfe5ec"/>
            </g>
            <!-- grille -->
