<!-- ================= M10 · BEAM PATTERN THEATRE ================= -->
<section class="mod mod-dark" id="theatre">
  <div class="wrap">
    <div class="mod-head">
      <div class="mod-tag">M10 · Beam Pattern Theatre</div>
      <h2 class="mt">Đèn không phải cứ sáng là tốt</h2>
      <p class="mod-lede">Bốn kiểu vùng sáng — mỗi kiểu làm được gì, và không làm được gì. Sơ đồ nhìn từ trên xuống, xe ở dưới.</p>
    </div>

    <div class="th-tabs" role="tablist">
      <button class="th-tab on" data-tp="cos">Cos rộng</button>
      <button class="th-tab" data-tp="bucos">Bù Cos trung tâm</button>
      <button class="th-tab" data-tp="pha">Pha gom</button>
      <button class="th-tab" data-tp="combo">Combo rộng + xa</button>
    </div>

    <!-- COS -->
    <div class="th-pane on" data-pane="cos">
      <div>
        <div class="diagram">
          <svg viewBox="0 0 480 300">
            <rect width="480" height="300" fill="#0d1119"/>
            <rect x="150" y="0" width="180" height="300" fill="#141a24"/>
            <line x1="150" y1="0" x2="150" y2="300" stroke="#242e3a" stroke-width="2"/>
            <line x1="330" y1="0" x2="330" y2="300" stroke="#242e3a" stroke-width="2"/>
            <line x1="240" y1="0" x2="240" y2="300" stroke="#2c3644" stroke-width="2" stroke-dasharray="14 12"/>
            <g stroke="#1f2833" stroke-width="1"><line x1="0" y1="90" x2="480" y2="90"/><line x1="0" y1="170" x2="480" y2="170"/></g>
            <g fill="#5b6673" font-size="10" font-family="sans-serif"><text x="8" y="84">XA</text><text x="8" y="164">GIỮA</text><text x="8" y="266">GẦN</text></g>
            <polygon points="196,228 284,228 372,96 108,96" fill="#ffc46b" opacity=".38"/>
            <line x1="108" y1="96" x2="372" y2="96" stroke="#ffc46b" stroke-width="2.5" opacity=".85"/>
            <rect x="214" y="228" width="52" height="64" rx="9" fill="#39414d"/>
            <rect x="222" y="232" width="36" height="12" rx="3" fill="#222a34"/>
            <circle cx="222" cy="229" r="2.6" fill="#ffe7c2"/><circle cx="258" cy="229" r="2.6" fill="#ffe7c2"/>
          </svg>
          <div class="cap">Sơ đồ vùng sáng minh họa (không theo tỷ lệ). Ảnh đường thật chèn từ Case Log — không dựng bằng CSS.</div>
        </div>
        <div class="ph-dark">◐ &nbsp;Ảnh đường thật chế độ Cos — chờ Auto365 Case Log (cùng xe, cùng vị trí máy, cùng exposure)</div>
      </div>
      <div class="th-info">
        <h3>Cos rộng — tấm thảm sáng trước đầu xe</h3>
        <p>Trải ánh sáng thấp và rộng ra hai mép đường, có đường cắt sáng phía trên để không hắt vào mắt xe đối diện. Đây là chế độ dùng nhiều nhất — và cũng là chế độ quyết định xe ngược chiều có bị chói hay không.</p>
        <div class="th-facts">
          <div><span>Nguồn tiêu biểu</span> M30 Ultra V2 · M40 Ultra V2 · M30 Ultra</div>
          <div><span>Thông số</span> Cos ~70–80W theo SSOT từng mẫu</div>
          <div><span>Điều kiện dùng</span> Phố, mưa, đường đông xe ngược chiều</div>
          <div><span>Căn chỉnh</span> Đường cắt sáng phải nằm dưới tầm mắt xe đối diện</div>
        </div>
        <div class="th-note">Sáng hơn thôi chưa đủ. Góc chiếu phải đúng.</div>
      </div>
    </div>

    <!-- BU COS -->
    <div class="th-pane" data-pane="bucos">
      <div>
        <div class="diagram">
          <svg viewBox="0 0 480 300">
            <rect width="480" height="300" fill="#0d1119"/>
            <rect x="150" y="0" width="180" height="300" fill="#141a24"/>
            <line x1="150" y1="0" x2="150" y2="300" stroke="#242e3a" stroke-width="2"/>
            <line x1="330" y1="0" x2="330" y2="300" stroke="#242e3a" stroke-width="2"/>
            <line x1="240" y1="0" x2="240" y2="300" stroke="#2c3644" stroke-width="2" stroke-dasharray="14 12"/>
            <g stroke="#1f2833" stroke-width="1"><line x1="0" y1="90" x2="480" y2="90"/><line x1="0" y1="170" x2="480" y2="170"/></g>
            <g fill="#5b6673" font-size="10" font-family="sans-serif"><text x="8" y="84">XA</text><text x="8" y="164">GIỮA</text><text x="8" y="266">GẦN</text></g>
            <polygon points="196,228 284,228 366,100 114,100" fill="#ffc46b" opacity=".28"/>
            <ellipse cx="240" cy="135" rx="64" ry="34" fill="#ffe7c2" opacity=".5"/>
            <line x1="114" y1="100" x2="366" y2="100" stroke="#ffc46b" stroke-width="2" opacity=".7"/>
            <rect x="214" y="228" width="52" height="64" rx="9" fill="#39414d"/>
            <rect x="222" y="232" width="36" height="12" rx="3" fill="#222a34"/>
            <circle cx="222" cy="229" r="2.6" fill="#ffe7c2"/><circle cx="258" cy="229" r="2.6" fill="#ffe7c2"/>
          </svg>
          <div class="cap">Vệt sáng đặc ở dải giữa — vùng hay bị "hụt" giữa Cos gần và Pha xa.</div>
        </div>
        <div class="ph-dark">◐ &nbsp;Ảnh đường thật chế độ Bù Cos — chờ Auto365 Case Log</div>
      </div>
      <div class="th-info">
        <h3>Bù Cos — lấp khoảng tối ở dải giữa</h3>
        <p>Nhiều xe sáng gần, sáng xa, nhưng hụt đúng dải giữa — nơi mắt người lái tập trung ở tốc độ 50–80 km/h. Nguồn Bù Cos đặt tại lens trung tâm bơm thêm ánh sáng vào đúng dải đó, hoạt động cùng hai nguồn Cos chính.</p>
        <div class="th-facts">
          <div><span>Nguồn tiêu biểu</span> X-Light F30 Ultra (cấu trúc 6+6+3)</div>
          <div><span>Thông số</span> Cos ~75W gồm nguồn Bù Cos 3 chip</div>
          <div><span>Điều kiện dùng</span> Đường tỉnh thiếu sáng, đi đêm dài</div>
          <div><span>Căn chỉnh</span> Bù Cos không thay thế Pha — không chỉnh ngóc lên</div>
        </div>
        <div class="th-note">Nguồn thông số: x-light.vn — production đọc từ Product SSOT.</div>
      </div>
    </div>

    <!-- PHA -->
    <div class="th-pane" data-pane="pha">
      <div>
        <div class="diagram">
          <svg viewBox="0 0 480 300">
            <rect width="480" height="300" fill="#0d1119"/>
            <rect x="150" y="0" width="180" height="300" fill="#141a24"/>
            <line x1="150" y1="0" x2="150" y2="300" stroke="#242e3a" stroke-width="2"/>
            <line x1="330" y1="0" x2="330" y2="300" stroke="#242e3a" stroke-width="2"/>
            <line x1="240" y1="0" x2="240" y2="300" stroke="#2c3644" stroke-width="2" stroke-dasharray="14 12"/>
            <g stroke="#1f2833" stroke-width="1"><line x1="0" y1="90" x2="480" y2="90"/><line x1="0" y1="170" x2="480" y2="170"/></g>
            <g fill="#5b6673" font-size="10" font-family="sans-serif"><text x="8" y="84">XA</text><text x="8" y="164">GIỮA</text><text x="8" y="266">GẦN</text></g>
            <polygon points="216,228 264,228 258,12 222,12" fill="#ffe7c2" opacity=".5"/>
            <ellipse cx="240" cy="46" rx="30" ry="18" fill="#ffe7c2" opacity=".6"/>
            <rect x="214" y="228" width="52" height="64" rx="9" fill="#39414d"/>
            <rect x="222" y="232" width="36" height="12" rx="3" fill="#222a34"/>
            <circle cx="222" cy="229" r="2.6" fill="#ffe7c2"/><circle cx="258" cy="229" r="2.6" fill="#ffe7c2"/>
          </svg>
          <div class="cap">Chùm gom hẹp, đẩy chiều sâu — đổi bề rộng lấy tầm quan sát.</div>
        </div>
        <div class="ph-dark">◐ &nbsp;Ảnh đường thật chế độ Pha — chờ Auto365 Case Log</div>
      </div>
      <div class="th-info">
        <h3>Pha gom — chiều sâu cho đường trường</h3>
        <p>Gom chùm sáng vào trục giữa để đẩy tầm quan sát ra xa: biển báo, vật cản, khúc cua hiện sớm hơn. Đổi lại, hai mép đường nhận ít ánh sáng hơn — nên Pha luôn cần đi cùng nền Cos.</p>
        <div class="th-facts">
          <div><span>Nguồn tiêu biểu</span> M40 Ultra V2 (Dual Direct Beam) · M30 Ultra V2</div>
          <div><span>Thông số</span> Pha ~95–110W theo SSOT từng mẫu</div>
          <div><span>Điều kiện dùng</span> Cao tốc vắng, đường trường không có xe đối diện</div>
          <div><span>Căn chỉnh</span> Bắt buộc công tắc độc lập — tắt ngay khi có xe ngược chiều</div>
        </div>
        <div class="th-note">Khách không mua thông số. Khách mua tầm nhìn khi cần vượt xe lúc 9 giờ tối.</div>
      </div>
    </div>

    <!-- COMBO -->
    <div class="th-pane" data-pane="combo">
      <div>
        <div class="diagram">
          <svg viewBox="0 0 480 300">
            <rect width="480" height="300" fill="#0d1119"/>
            <rect x="150" y="0" width="180" height="300" fill="#141a24"/>
            <line x1="150" y1="0" x2="150" y2="300" stroke="#242e3a" stroke-width="2"/>
            <line x1="330" y1="0" x2="330" y2="300" stroke="#242e3a" stroke-width="2"/>
            <line x1="240" y1="0" x2="240" y2="300" stroke="#2c3644" stroke-width="2" stroke-dasharray="14 12"/>
            <g stroke="#1f2833" stroke-width="1"><line x1="0" y1="90" x2="480" y2="90"/><line x1="0" y1="170" x2="480" y2="170"/></g>
            <g fill="#5b6673" font-size="10" font-family="sans-serif"><text x="8" y="84">XA</text><text x="8" y="164">GIỮA</text><text x="8" y="266">GẦN</text></g>
            <polygon points="196,228 284,228 372,100 108,100" fill="#ffc46b" opacity=".3"/>
            <polygon points="220,228 260,228 256,16 224,16" fill="#ffe7c2" opacity=".42"/>
            <line x1="108" y1="100" x2="372" y2="100" stroke="#ffc46b" stroke-width="2" opacity=".6"/>
            <rect x="214" y="228" width="52" height="64" rx="9" fill="#39414d"/>
            <rect x="222" y="232" width="36" height="12" rx="3" fill="#222a34"/>
            <circle cx="222" cy="229" r="2.6" fill="#ffe7c2"/><circle cx="258" cy="229" r="2.6" fill="#ffe7c2"/>
          </svg>
          <div class="cap">Nền rộng của Cos + trục sâu của Pha — cấu hình cho đèo và đường trường hỗn hợp.</div>
        </div>
        <div class="ph-dark">◐ &nbsp;Ảnh đường thật chế độ Combo — chờ Auto365 Case Log</div>
      </div>
      <div class="th-info">
        <h3>Combo rộng + xa — một hệ, hai lớp sáng</h3>
        <p>Giữ nền Cos rộng làm chuẩn, kích thêm trục Pha khi cần chiều sâu. Đây là cách các mẫu đa tầng như M40 Ultra V2 phát huy giá trị — nhưng cũng là cấu hình đòi hỏi đi dây, relay và công tắc đúng chuẩn nhất.</p>
        <div class="th-facts">
          <div><span>Nguồn tiêu biểu</span> M40 Ultra V2 · F30 Ultra</div>
          <div><span>Thông số</span> Cos + Pha kích hoạt theo lớp, theo SSOT</div>
          <div><span>Điều kiện dùng</span> Đèo, đường trường hỗn hợp, bán tải chạy tỉnh</div>
          <div><span>Căn chỉnh</span> Relay + cầu chì đúng tải; kiểm tra sụt áp trước bàn giao</div>
        </div>
        <div class="th-note">Combo sai cách đi dây là lỗi hay gặp nhất — không phải lỗi đèn.</div>
      </div>
    </div>
  </div>
</section>

