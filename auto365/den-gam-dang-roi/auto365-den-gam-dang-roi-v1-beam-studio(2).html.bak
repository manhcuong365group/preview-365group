<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Đèn Gầm dạng rời | Auto365 — DEMO V1 Beam Studio Commerce Pillar</title>
<meta name="description" content="Đèn trợ sáng dạng rời ô tô — chọn theo cung đường, kiểu vùng sáng, vị trí lắp và hệ điện của xe. Demo nội bộ V1.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://auto365.vn/den-gam-dang-roi#page",
      "url": "https://auto365.vn/den-gam-dang-roi",
      "name": "Đèn Gầm dạng rời",
      "inLanguage": "vi-VN",
      "isPartOf": { "@id": "https://auto365.vn/#website" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Trang chủ", "item": "https://auto365.vn/" },
        { "@type": "ListItem", "position": 2, "name": "Ánh sáng", "item": "https://auto365.vn/nang-cap-anh-sang" },
        { "@type": "ListItem", "position": 3, "name": "Đèn Gầm dạng rời", "item": "https://auto365.vn/den-gam-dang-roi" }
      ]
    },
    {
      "@type": "ItemList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "item": { "@type": "Product", "name": "Đèn gầm dạng rời X-Light F30 Ultra", "url": "https://auto365.vn/x-light-f30-ultra", "brand": { "@type": "Brand", "name": "X-Light" }, "offers": { "@type": "Offer", "price": "4800000", "priceCurrency": "VND" } } },
        { "@type": "ListItem", "position": 2, "item": { "@type": "Product", "name": "Đèn trợ sáng Titan M40 Ultra V2", "url": "https://auto365.vn/den-tro-sang-titan-m40-ultra-v2", "brand": { "@type": "Brand", "name": "Titan" }, "offers": { "@type": "Offer", "price": "6500000", "priceCurrency": "VND" } } },
        { "@type": "ListItem", "position": 3, "item": { "@type": "Product", "name": "Đèn trợ sáng Titan Moto M30 Ultra V2", "url": "https://auto365.vn/den-tro-sang-titan-moto-m30-ultra-v2", "brand": { "@type": "Brand", "name": "Titan Moto" }, "offers": { "@type": "Offer", "price": "5500000", "priceCurrency": "VND" } } },
        { "@type": "ListItem", "position": 4, "item": { "@type": "Product", "name": "Đèn trợ sáng Titan M30 Ultra", "url": "https://auto365.vn/den-tro-sang-titan-m30-ultra", "brand": { "@type": "Brand", "name": "Titan" }, "offers": { "@type": "Offer", "price": "4500000", "priceCurrency": "VND" } } },
        { "@type": "ListItem", "position": 5, "item": { "@type": "Product", "name": "Đèn gầm dạng rời Titan Moto M10 Ultra V3", "url": "https://auto365.vn/den-gam-dang-roi-titan-moto-m10-ultra-v3", "brand": { "@type": "Brand", "name": "Titan Moto" }, "offers": { "@type": "Offer", "price": "2000000", "priceCurrency": "VND" } } }
      ]
    }
  ]
}
</script>
<style>
/* ============ TOKENS ============ */
:root{
  --bg:#ffffff; --bg-soft:#f5f6f8; --ink:#0e1318; --ink2:#38414b; --muted:#6a7480;
  --line:#e5e8ec; --line2:#d3d9e0;
  --red:#d5232b; --red-ink:#ad1a21; --red-soft:#fdeeee;
  --amber:#c07f1d; --amber-bg:#fdf3e0; --amber-line:#eed9ae;
  --green:#1d7f48; --green-bg:#e8f5ee; --green-line:#bfe3cd;
  --slate:#5a6572; --slate-bg:#eef1f4;
  --dark:#0a0e14; --dark2:#10151d; --dark3:#161d27; --dline:#242e3a; --dink:#edf1f6; --dmut:#8d98a5;
  --beam:#ffc46b;
  --r:14px; --r-sm:10px;
  --shadow:0 10px 30px rgba(14,19,24,.08);
  --font:'Be Vietnam Pro',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:var(--font);color:var(--ink);background:var(--bg);line-height:1.65;font-size:16px;-webkit-font-smoothing:antialiased}
img{max-width:100%;display:block}
a{color:inherit}
button{font-family:var(--font);cursor:pointer}
.wrap{max-width:1200px;margin:0 auto;padding:0 24px}
section.mod{padding:76px 0;scroll-margin-top:118px}
.mod-tag{font-size:11px;letter-spacing:.16em;font-weight:700;color:var(--muted);text-transform:uppercase;display:flex;align-items:center;gap:10px;margin-bottom:14px}
.mod-tag::before{content:"";width:26px;height:2px;background:var(--red);display:inline-block}
.mod-dark .mod-tag{color:var(--dmut)}
h2.mt{font-size:clamp(26px,3.2vw,36px);line-height:1.2;font-weight:800;letter-spacing:-.01em;margin-bottom:14px}
.mod-lede{color:var(--muted);max-width:720px;font-size:16.5px}
.mod-dark .mod-lede{color:var(--dmut)}
.mod-head{margin-bottom:40px}
.mod-soft{background:var(--bg-soft)}
.mod-dark{background:var(--dark);color:var(--dink)}
.mod-dark2{background:var(--dark2);color:var(--dink)}

/* ============ BADGES ============ */
.tag{display:inline-flex;align-items:center;gap:5px;font-size:10.5px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;padding:3px 9px;border-radius:999px;border:1px solid var(--line2);color:var(--muted);background:#fff;white-space:nowrap}
.b-ok{border-color:var(--green-line);background:var(--green-bg);color:var(--green)}
.b-wait{border-color:var(--amber-line);background:var(--amber-bg);color:var(--amber)}
.b-demo{border-color:var(--line2);background:var(--slate-bg);color:var(--slate)}
.b-src{border-style:dashed;font-weight:500;text-transform:none;letter-spacing:0}
.mod-dark .tag{background:transparent;border-color:var(--dline);color:var(--dmut)}
.mod-dark .b-ok{border-color:#1d5c39;background:#0f2419;color:#5ecf8f}
.mod-dark .b-wait{border-color:#5c481d;background:#241d0f;color:#e3b45c}

/* ============ BUTTONS ============ */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;font-weight:700;font-size:15px;padding:13px 24px;border-radius:11px;border:1.5px solid transparent;text-decoration:none;transition:.18s;line-height:1.2}
.btn-p{background:var(--red);color:#fff}
.btn-p:hover{background:var(--red-ink)}
.btn-o{border-color:var(--line2);color:var(--ink);background:#fff}
.btn-o:hover{border-color:var(--ink)}
.btn-g{color:var(--ink2);background:transparent;padding-left:10px;padding-right:10px}
.btn-g:hover{color:var(--red)}
.btn-w{border-color:var(--dline);color:var(--dink);background:transparent}
.btn-w:hover{border-color:var(--dmut)}
.btn-s{font-size:13.5px;padding:9px 16px;border-radius:9px}
.btn[disabled]{opacity:.45;cursor:not-allowed}

/* ============ DEMO BANNER + HEADER ============ */
.banner-demo{background:var(--dark);color:#cfd6de;font-size:12.5px;text-align:center;padding:8px 16px;line-height:1.5}
.banner-demo b{color:var(--beam);font-weight:700}
.hdr{position:sticky;top:0;z-index:60;background:rgba(255,255,255,.96);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
.hdr-in{display:flex;align-items:center;gap:28px;height:64px}
.logo{font-weight:800;font-size:21px;letter-spacing:-.02em;text-decoration:none;white-space:nowrap}
.logo b{color:var(--red)}
.logo small{display:block;font-size:9.5px;font-weight:600;letter-spacing:.22em;color:var(--muted);margin-top:-3px}
.hdr-nav{display:flex;gap:22px;font-size:14.5px;font-weight:600;color:var(--ink2);margin-left:8px}
.hdr-nav a{text-decoration:none;padding:6px 0}
.hdr-nav a:hover{color:var(--red)}
.hdr-sp{flex:1}
.hdr-hot{font-size:13px;color:var(--muted);text-align:right;line-height:1.3;white-space:nowrap}
.hdr-hot b{display:block;font-size:15.5px;color:var(--ink);letter-spacing:.02em}
.subnav{position:sticky;top:64px;z-index:55;background:#fff;border-bottom:1px solid var(--line);overflow-x:auto;scrollbar-width:none}
.subnav::-webkit-scrollbar{display:none}
.subnav-in{display:flex;gap:6px;padding:9px 24px;max-width:1200px;margin:0 auto;white-space:nowrap}
.subnav a{font-size:13px;font-weight:600;color:var(--muted);text-decoration:none;padding:6px 13px;border-radius:999px;border:1px solid transparent}
.subnav a:hover{color:var(--ink);border-color:var(--line2)}
.crumbs{font-size:13px;color:var(--muted);padding:18px 0 0}
.crumbs a{text-decoration:none;color:var(--muted)}
.crumbs a:hover{color:var(--red)}
.crumbs b{color:var(--ink);font-weight:600}
.ctx-banner{display:none;background:var(--red-soft);border-bottom:1px solid #f5cdcf;color:var(--red-ink);font-size:13.5px;font-weight:600;padding:9px 24px;text-align:center}
.ctx-banner.show{display:block}

/* ============ HERO ============ */
.hero{padding:44px 0 64px}
.hero-grid{display:grid;grid-template-columns:1.02fr .98fr;gap:52px;align-items:start}
.hero-hook{font-size:15px;font-weight:600;color:var(--red);margin-bottom:14px;letter-spacing:.01em}
h1.h1{font-size:clamp(34px,4.6vw,52px);line-height:1.08;font-weight:800;letter-spacing:-.02em;margin-bottom:16px}
.hero-sub{font-size:17.5px;color:var(--ink2);max-width:520px;margin-bottom:26px}
.hero-ctas{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:22px}
.hero-note{font-size:13px;color:var(--muted)}
/* Beam stage */
.stage{background:var(--dark);border-radius:18px;overflow:hidden;box-shadow:var(--shadow);border:1px solid #1a222d}
.stage-vis{position:relative}
.stage-vis svg{display:block;width:100%;height:auto}
.stage-label{position:absolute;top:10px;left:10px;font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;font-weight:700;color:#aab4c0;background:rgba(10,14,20,.82);border:1px solid #2a3442;padding:4px 9px;border-radius:6px}
.stage-ui{padding:16px 18px 18px;border-top:1px solid #1a222d}
.stage-tabs{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:10px}
.stab{background:var(--dark3);color:#c3ccd6;border:1px solid var(--dline);font-size:13px;font-weight:700;padding:8px 15px;border-radius:9px;transition:.15s}
.stab:hover{border-color:#3a4757}
.stab.on{background:var(--beam);color:#231803;border-color:var(--beam)}
.ktabs{display:flex;gap:7px;flex-wrap:wrap}
.ktab{background:transparent;color:#8d98a5;border:1px solid var(--dline);font-size:12px;font-weight:600;padding:6px 12px;border-radius:999px}
.ktab.on{color:var(--dink);border-color:#8d98a5}
.stage-meta{display:grid;grid-template-columns:repeat(3,1fr);gap:8px 16px;padding:14px 18px;background:var(--dark2);border-top:1px solid #1a222d;font-size:12px;color:var(--dmut)}
.stage-meta b{display:block;color:var(--dink);font-weight:600;font-size:12.5px}
.stage-cap{font-size:11.5px;color:#6c7885;padding:10px 18px 14px;background:var(--dark2)}

/* ============ ANSWER + PROOF ============ */
.answer{border:1px solid var(--line);border-left:4px solid var(--red);border-radius:var(--r);padding:26px 30px;background:#fff;max-width:920px}
.answer h3{font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-bottom:10px;font-weight:700}
.answer p{font-size:16.5px;color:var(--ink2)}
.answer p b{color:var(--ink)}
.proof{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:var(--r);overflow:hidden}
.proof-i{background:#fff;padding:22px 22px 18px}
.proof-i .n{font-size:26px;font-weight:800;letter-spacing:-.01em;line-height:1.1}
.proof-i .l{font-size:13.5px;color:var(--ink2);font-weight:600;margin:4px 0 8px}
.proof-tag{text-align:center;margin-top:22px;font-weight:700;color:var(--ink2);letter-spacing:.01em}

/* ============ BEAMMATCH ============ */
.bm{border:1px solid var(--line);border-radius:18px;background:#fff;box-shadow:var(--shadow);overflow:hidden}
.bm-top{display:flex;align-items:center;gap:14px;padding:20px 28px;border-bottom:1px solid var(--line);flex-wrap:wrap}
.bm-steps{display:flex;gap:6px;flex:1;min-width:260px}
.bm-st{flex:1;height:4px;border-radius:99px;background:var(--line)}
.bm-st.done{background:var(--red)}
.bm-count{font-size:13px;font-weight:700;color:var(--muted);white-space:nowrap}
.bm-body{padding:30px 28px 28px}
.bm-q{font-size:21px;font-weight:800;margin-bottom:6px}
.bm-hint{font-size:14px;color:var(--muted);margin-bottom:22px}
.opt-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px}
.opt{border:1.5px solid var(--line2);border-radius:12px;padding:16px;background:#fff;text-align:left;transition:.15s;display:flex;flex-direction:column;gap:8px}
.opt:hover{border-color:var(--ink2)}
.opt.sel{border-color:var(--red);background:var(--red-soft)}
.opt .oi{font-size:22px;line-height:1}
.opt .ot{font-weight:700;font-size:15px;line-height:1.3}
.opt .od{font-size:12.5px;color:var(--muted);line-height:1.45}
.opt svg{width:100%;height:auto;border-radius:8px;background:var(--dark)}
.bm-nav{display:flex;justify-content:space-between;align-items:center;padding:18px 28px;border-top:1px solid var(--line);background:var(--bg-soft)}
.field{display:flex;flex-direction:column;gap:6px;font-size:13.5px;font-weight:600;color:var(--ink2)}
.field select,.field input{font-family:var(--font);font-size:15px;padding:11px 13px;border:1.5px solid var(--line2);border-radius:10px;background:#fff;color:var(--ink)}
.field select:focus,.field input:focus{outline:none;border-color:var(--red)}
.f-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.chiprow{display:flex;gap:8px;flex-wrap:wrap}
.chip{border:1.5px solid var(--line2);background:#fff;border-radius:999px;font-size:13.5px;font-weight:600;padding:8px 16px;color:var(--ink2)}
.chip.sel{border-color:var(--red);background:var(--red-soft);color:var(--red-ink)}
.bm-resume{display:none;margin-bottom:16px;border:1px solid var(--amber-line);background:var(--amber-bg);border-radius:12px;padding:14px 18px;font-size:14.5px;color:var(--amber);font-weight:600;align-items:center;gap:12px;justify-content:space-between;flex-wrap:wrap}
.bm-resume.show{display:flex}

/* ============ RESULT ============ */
.reco{display:none;margin-top:34px}
.reco.show{display:block}
.reco-card{border:1.5px solid var(--ink);border-radius:18px;overflow:hidden;background:#fff}
.reco-hd{background:var(--dark);color:var(--dink);padding:18px 26px;display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.reco-hd .k{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--beam);font-weight:700}
.reco-hd h3{font-size:22px;font-weight:800;width:100%}
.reco-bd{display:grid;grid-template-columns:220px 1fr;gap:26px;padding:26px}
.reco-img{border:1px solid var(--line);border-radius:12px;overflow:hidden;background:var(--bg-soft);align-self:start}
.reco-img img{aspect-ratio:1/1;object-fit:cover;width:100%}
.reco-spec{display:grid;grid-template-columns:repeat(2,1fr);gap:10px 22px;font-size:14.5px}
.reco-spec div{border-bottom:1px dashed var(--line);padding-bottom:8px}
.reco-spec span{display:block;font-size:11.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:700;margin-bottom:2px}
.reco-spec b{font-weight:700}
.reco-why{grid-column:1/-1;background:var(--bg-soft);border-radius:12px;padding:16px 20px;font-size:14.5px;color:var(--ink2)}
.reco-why b{color:var(--ink)}
.reco-ctas{display:flex;gap:12px;flex-wrap:wrap;padding:0 26px 26px}
.lane{display:inline-flex;align-items:center;gap:7px;font-size:12.5px;font-weight:700;padding:6px 13px;border-radius:999px}
.lane-g{background:var(--green-bg);color:var(--green);border:1px solid var(--green-line)}
.lane-y{background:var(--amber-bg);color:var(--amber);border:1px solid var(--amber-line)}
details.alt{border:1px solid var(--line);border-radius:14px;background:#fff;margin-top:12px;overflow:hidden}
details.alt summary{list-style:none;cursor:pointer;padding:16px 22px;font-weight:700;font-size:15px;display:flex;align-items:center;gap:10px;color:var(--ink2)}
details.alt summary::-webkit-details-marker{display:none}
details.alt summary::after{content:"+";margin-left:auto;font-size:20px;color:var(--muted);font-weight:600}
details.alt[open] summary::after{content:"–"}
details.alt .alt-bd{padding:0 22px 20px;display:grid;grid-template-columns:110px 1fr;gap:18px;font-size:14px;color:var(--ink2)}
details.alt .alt-bd img{border:1px solid var(--line);border-radius:10px;aspect-ratio:1/1;object-fit:cover}

/* ============ PRODUCT GRID ============ */
.filters{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:26px;align-items:center}
.filters .fl{font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-right:4px}
.pgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(268px,1fr));gap:20px}
.pcard{border:1px solid var(--line);border-radius:16px;background:#fff;overflow:hidden;display:flex;flex-direction:column;transition:.18s}
.pcard:hover{box-shadow:var(--shadow);transform:translateY(-2px)}
.pcard.hl{outline:3px solid var(--red);outline-offset:2px}
.pimg{position:relative;background:var(--bg-soft);border-bottom:1px solid var(--line)}
.pimg img{aspect-ratio:4/3;object-fit:cover;width:100%}
.pimg .ph{aspect-ratio:4/3;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:34px;color:var(--line2);background:repeating-linear-gradient(45deg,#f2f4f6,#f2f4f6 12px,#eceef1 12px,#eceef1 24px)}
.pimg .beam-mini{position:absolute;right:10px;bottom:10px;width:74px;border-radius:8px;overflow:hidden;border:1px solid #2a3442;box-shadow:0 4px 12px rgba(0,0,0,.25)}
.pbody{padding:18px 18px 16px;display:flex;flex-direction:column;gap:11px;flex:1}
.pname{font-weight:800;font-size:16.5px;line-height:1.3}
.prole{font-size:13px;color:var(--red-ink);font-weight:700}
.pspecs{display:grid;grid-template-columns:1fr 1fr;gap:5px 14px;font-size:12.5px;color:var(--ink2)}
.pspecs span{color:var(--muted)}
.pprice{display:flex;align-items:baseline;gap:8px;margin-top:auto;padding-top:8px;border-top:1px dashed var(--line)}
.pprice b{font-size:19px;font-weight:800}
.pprice small{font-size:11.5px;color:var(--muted)}
.pbadges{display:flex;flex-wrap:wrap;gap:6px}
.pcta{display:flex;gap:8px;flex-wrap:wrap}
.pcta .btn-s{flex:1;min-width:130px}
.pcta .btn-g{flex-basis:100%;justify-content:flex-start;padding:2px 0;font-size:13px}

/* ============ DARK STUDIO ============ */
.th-tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:30px}
.th-tab{background:var(--dark3);border:1px solid var(--dline);color:#c3ccd6;font-size:14px;font-weight:700;padding:11px 20px;border-radius:11px}
.th-tab.on{background:var(--beam);border-color:var(--beam);color:#231803}
.th-pane{display:none;grid-template-columns:1.05fr .95fr;gap:34px;align-items:start}
.th-pane.on{display:grid}
.diagram{background:var(--dark2);border:1px solid var(--dline);border-radius:16px;overflow:hidden}
.diagram svg{width:100%;height:auto;display:block}
.diagram .cap{font-size:11.5px;color:var(--dmut);padding:10px 16px;border-top:1px solid var(--dline)}
.th-info h3{font-size:22px;font-weight:800;margin-bottom:10px}
.th-info p{color:#b9c2cd;font-size:15px;margin-bottom:16px}
.th-facts{display:grid;grid-template-columns:1fr 1fr;gap:10px 20px;font-size:13.5px;margin-bottom:16px}
.th-facts div{border-bottom:1px dashed var(--dline);padding-bottom:8px}
.th-facts span{display:block;font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--dmut);font-weight:700}
.th-note{font-size:13px;color:var(--dmut);border-left:3px solid var(--beam);padding-left:12px}
.ph-dark{border:1px dashed var(--dline);border-radius:12px;padding:22px;text-align:center;font-size:12.5px;color:var(--dmut);background:var(--dark2);margin-top:14px}
/* exploded */
.ex-tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:26px}
.ex-pane{display:none;grid-template-columns:1.1fr .9fr;gap:34px;align-items:center}
.ex-pane.on{display:grid}
.ex-list{display:flex;flex-direction:column;gap:12px}
.ex-it{display:flex;gap:14px;align-items:flex-start;border:1px solid var(--dline);background:var(--dark2);border-radius:12px;padding:14px 16px}
.ex-it .no{font-size:12px;font-weight:800;color:#231803;background:var(--beam);border-radius:7px;min-width:26px;height:26px;display:flex;align-items:center;justify-content:center}
.ex-it b{display:block;font-size:14.5px}
.ex-it small{color:var(--dmut);font-size:12.5px;line-height:1.5;display:block}

/* ============ MOUNTING ============ */
.mount-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:36px;align-items:start}
.mount-svgbox{border:1px solid var(--line);border-radius:16px;background:linear-gradient(180deg,#fafbfc,#f1f3f6);padding:10px;position:relative}
.mount-svgbox svg{width:100%;height:auto;display:block}
.hs{cursor:pointer}
.hs circle.ring{fill:rgba(213,35,43,.14);stroke:var(--red);stroke-width:1.5;transition:.15s}
.hs.on circle.ring{fill:rgba(213,35,43,.28);stroke-width:2.5}
.hs text{font-family:var(--font);font-weight:800;font-size:13px;fill:var(--red-ink)}
.hs.dim circle.ring{stroke:var(--line2);fill:rgba(90,101,114,.08)}
.hs.dim text{fill:var(--muted)}
.aes{display:flex;gap:8px;margin-bottom:18px}
.aes .chip{flex:1;text-align:center;justify-content:center;display:inline-flex}
.mount-panel{border:1px solid var(--line);border-radius:16px;background:#fff;padding:24px;box-shadow:var(--shadow)}
.mount-panel h3{font-size:19px;font-weight:800;margin-bottom:4px}
.mount-panel .sub{font-size:13px;color:var(--muted);margin-bottom:16px}
.mp-rows{display:flex;flex-direction:column;gap:0;font-size:14px}
.mp-rows>div{display:flex;justify-content:space-between;gap:18px;padding:9px 0;border-bottom:1px dashed var(--line)}
.mp-rows span{color:var(--muted);flex-shrink:0}
.mp-rows b{text-align:right;font-weight:600}
.mp-foot{margin-top:16px;display:flex;gap:8px;flex-wrap:wrap}

/* ============ PRICE BUILDER ============ */
.pb-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:36px;align-items:start}
.pb-card{border:1px solid var(--line);border-radius:16px;background:#fff;box-shadow:var(--shadow);overflow:hidden}
.pb-hd{padding:18px 24px;border-bottom:1px solid var(--line);display:flex;gap:12px;align-items:center;flex-wrap:wrap}
.pb-hd select{flex:1;min-width:200px;font-family:var(--font);font-size:15px;font-weight:600;padding:10px 13px;border:1.5px solid var(--line2);border-radius:10px}
.pb-rows{padding:10px 24px}
.pb-row{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:12px 0;border-bottom:1px dashed var(--line);font-size:14.5px}
.pb-row .l{color:var(--ink2)}
.pb-row .l small{display:block;color:var(--muted);font-size:12px}
.pb-row .v{font-weight:700;white-space:nowrap}
.pb-row .v.wait{color:var(--amber);font-weight:600;font-size:13px}
.pb-total{padding:18px 24px;background:var(--dark);color:var(--dink);display:flex;justify-content:space-between;align-items:center;gap:16px}
.pb-total .v{font-size:20px;font-weight:800;color:var(--beam)}
.pb-states{display:flex;gap:8px;margin-bottom:16px}
.pb-note{font-size:13px;color:var(--muted);margin-top:14px}
.pb-side h3{font-size:19px;font-weight:800;margin-bottom:10px}
.pb-side p{color:var(--ink2);font-size:15px;margin-bottom:14px}
.pb-side ul{margin:0 0 16px 18px;color:var(--ink2);font-size:14.5px}
.pb-side li{margin-bottom:7px}

/* ============ COMPARE ============ */
.cmp-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:16px;background:#fff}
table.cmp{border-collapse:collapse;width:100%;min-width:920px;font-size:14px}
.cmp th,.cmp td{padding:13px 16px;border-bottom:1px solid var(--line);vertical-align:top;text-align:left}
.cmp thead th{background:var(--dark);color:var(--dink);font-size:14.5px;position:sticky;top:0}
.cmp thead th small{display:block;color:var(--beam);font-weight:600;font-size:11.5px;margin-top:2px}
.cmp tbody th{background:var(--bg-soft);font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);font-weight:700;white-space:nowrap}
.cmp td b{font-weight:700}
.cmp td small{color:var(--muted);display:block;font-size:12px}
.cmp tr.fit td{background:#fbfcfd;font-size:13.5px}

/* ============ CASES ============ */
.case-toggle{display:inline-flex;border:1.5px solid var(--line2);border-radius:11px;overflow:hidden;margin-bottom:26px}
.case-toggle button{border:none;background:#fff;font-size:14px;font-weight:700;padding:10px 22px;color:var(--muted)}
.case-toggle button.on{background:var(--ink);color:#fff}
.case-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:20px}
.ccard{border:1px solid var(--line);border-radius:16px;background:#fff;overflow:hidden;display:flex;flex-direction:column}
.ccard.hl{outline:3px solid var(--red);outline-offset:2px}
.cimg{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--line)}
.cimg .ph{aspect-ratio:4/3;background:var(--dark2);color:var(--dmut);display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;font-weight:700;gap:6px;text-align:center;padding:8px}
.cimg .ph::before{content:"◐";font-size:20px;opacity:.5}
.cbody{padding:18px 20px;display:flex;flex-direction:column;gap:10px;flex:1}
.cbody h3{font-size:17px;font-weight:800}
.cmeta{display:flex;flex-direction:column;font-size:13.5px}
.cmeta>div{display:flex;justify-content:space-between;gap:14px;padding:7px 0;border-bottom:1px dashed var(--line)}
.cmeta span{color:var(--muted)}
.cmeta b{font-weight:600;text-align:right}
.ccard .btn-g{margin-top:auto;justify-content:flex-start;padding-left:0}
.ccard.pending{border-style:dashed;background:var(--bg-soft)}

/* ============ LAB / PROCESS / WARRANTY ============ */
.lab-grid{display:grid;grid-template-columns:1fr 1fr;gap:36px;align-items:start}
.lab-quote{font-size:clamp(21px,2.4vw,28px);font-weight:800;line-height:1.35;letter-spacing:-.01em}
.lab-quote em{color:var(--beam);font-style:normal}
.lab-rules{display:flex;flex-direction:column;gap:12px}
.lab-rule{display:flex;gap:14px;border:1px solid var(--dline);background:var(--dark2);border-radius:12px;padding:15px 18px;font-size:14px;color:#c3ccd6}
.lab-rule b{color:var(--dink)}
.lab-rule .ic{color:var(--beam);font-weight:800}
.steps{display:grid;grid-template-columns:repeat(6,1fr);gap:14px;counter-reset:st}
.step{border:1px solid var(--line);border-radius:14px;background:#fff;padding:18px 16px;position:relative}
.step::before{counter-increment:st;content:"0" counter(st);font-size:12px;font-weight:800;color:var(--red);letter-spacing:.08em}
.step b{display:block;font-size:14.5px;margin:6px 0 4px;line-height:1.35}
.step small{font-size:12.5px;color:var(--muted);line-height:1.45;display:block}
table.wty{width:100%;border-collapse:collapse;font-size:14.5px;background:#fff;border:1px solid var(--line);border-radius:16px;overflow:hidden}
.wty th,.wty td{padding:13px 18px;border-bottom:1px solid var(--line);text-align:left}
.wty thead th{background:var(--bg-soft);font-size:12px;letter-spacing:.07em;text-transform:uppercase;color:var(--muted)}
.wty td b{font-weight:700}

/* ============ ENTITY / CLUSTER ============ */
.tree{list-style:none;font-size:14.5px}
.tree ul{list-style:none;margin-left:26px;border-left:1.5px solid var(--line2);padding-left:20px}
.tree li{padding:5px 0;position:relative;color:var(--ink2)}
.tree ul li::before{content:"";position:absolute;left:-20px;top:17px;width:13px;height:1.5px;background:var(--line2)}
.tree b{font-weight:700;color:var(--ink)}
.node-cur{display:inline-block;background:var(--red);color:#fff;font-weight:700;padding:3px 12px;border-radius:8px}
.ent-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:40px;align-items:start}
.seo-aside{border:1px solid var(--line);border-radius:14px;background:#fff;padding:22px 24px;font-size:13.5px}
.seo-aside h4{font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:10px}
.seo-aside code{display:block;background:var(--dark);color:#c9e3a8;border-radius:9px;padding:10px 14px;font-size:12.5px;margin:6px 0 14px;overflow-x:auto;white-space:pre}
.clu-groups{display:grid;grid-template-columns:repeat(auto-fill,minmax(255px,1fr));gap:20px}
.clu{border:1px solid var(--line);border-radius:14px;background:#fff;padding:20px 22px}
.clu h3{font-size:15.5px;font-weight:800;margin-bottom:12px;display:flex;gap:8px;align-items:center}
.clu ol{margin-left:18px;font-size:13.5px;color:var(--ink2)}
.clu li{margin-bottom:7px}
.clu .tag{margin-top:12px}

/* ============ LEGAL / LEDGER / FAQ ============ */
.legal-box{border:1px solid var(--amber-line);background:var(--amber-bg);border-radius:16px;padding:26px 30px;max-width:920px}
.legal-box h3{font-size:17px;font-weight:800;margin-bottom:12px;color:var(--ink)}
.legal-box ul{margin-left:18px;color:var(--ink2);font-size:14.5px}
.legal-box li{margin-bottom:9px}
table.ledger{width:100%;border-collapse:collapse;font-size:13.5px;background:#fff;border:1px solid var(--line)}
.ledger th,.ledger td{padding:11px 14px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}
.ledger thead th{background:var(--dark);color:var(--dink);font-size:11.5px;letter-spacing:.07em;text-transform:uppercase}
.ledger td a{color:var(--red-ink);text-decoration:none;word-break:break-all}
.ledger td a:hover{text-decoration:underline}
details.faq{border:1px solid var(--line);border-radius:13px;background:#fff;margin-bottom:10px;overflow:hidden}
details.faq summary{list-style:none;cursor:pointer;padding:17px 22px;font-weight:700;font-size:15.5px;display:flex;gap:12px;align-items:center}
details.faq summary::-webkit-details-marker{display:none}
details.faq summary::after{content:"+";margin-left:auto;font-size:20px;color:var(--muted)}
details.faq[open] summary::after{content:"–"}
details.faq .fa{padding:0 22px 18px;color:var(--ink2);font-size:14.5px;max-width:820px}

/* ============ BOOKING ============ */
.book-grid{display:grid;grid-template-columns:.95fr 1.05fr;gap:36px;align-items:start}
.branchbox{border:1px solid var(--line);border-radius:16px;background:#fff;overflow:hidden}
.branch-reg{display:flex;gap:6px;padding:16px 20px;border-bottom:1px solid var(--line);flex-wrap:wrap}
.branch-list{max-height:330px;overflow-y:auto}
.br{display:flex;align-items:center;gap:12px;padding:14px 20px;border-bottom:1px dashed var(--line);font-size:14.5px;cursor:pointer}
.br:hover{background:var(--bg-soft)}
.br input{accent-color:var(--red);width:17px;height:17px}
.br b{font-weight:700;display:block}
.br small{color:var(--muted);font-size:12.5px}
.br .tag{margin-left:auto}
.branch-note{padding:13px 20px;font-size:12.5px;color:var(--muted);background:var(--bg-soft)}
.bk-form{border:1px solid var(--line);border-radius:16px;background:#fff;padding:26px;box-shadow:var(--shadow)}
.bk-form h3{font-size:19px;font-weight:800;margin-bottom:18px}
.bk-g2{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px}
.upl{display:none;grid-template-columns:repeat(3,1fr);gap:10px;margin:6px 0 14px}
.upl.show{display:grid}
.upl label{border:1.5px dashed var(--line2);border-radius:11px;padding:16px 10px;text-align:center;font-size:12px;color:var(--muted);cursor:pointer;line-height:1.4}
.upl label:hover{border-color:var(--red);color:var(--red-ink)}
.upl input{display:none}
.ck{display:flex;gap:10px;align-items:flex-start;font-size:14px;color:var(--ink2);margin-bottom:14px}
.ck input{accent-color:var(--red);width:17px;height:17px;margin-top:3px}
.toast{display:none;margin-top:16px;background:var(--green-bg);border:1px solid var(--green-line);color:var(--green);border-radius:11px;padding:14px 18px;font-size:14px;font-weight:600}
.toast.show{display:block}
.hotline-big{display:flex;align-items:center;gap:14px;margin-top:20px;border:1px solid var(--line);border-radius:14px;padding:16px 20px;background:var(--bg-soft)}
.hotline-big .ic{font-size:22px}
.hotline-big b{font-size:19px;letter-spacing:.02em;display:block}
.hotline-big small{color:var(--muted);font-size:12.5px}

/* ============ FOOTER / MISC ============ */
.foot{background:var(--dark);color:var(--dmut);padding:52px 0 110px;font-size:13.5px}
.foot-grid{display:grid;grid-template-columns:1.3fr 1fr 1fr;gap:36px;margin-bottom:30px}
.foot h4{color:var(--dink);font-size:13px;letter-spacing:.1em;text-transform:uppercase;margin-bottom:14px}
.foot a{color:var(--dmut);text-decoration:none;display:block;padding:4px 0}
.foot a:hover{color:var(--dink)}
.foot-bot{border-top:1px solid var(--dline);padding-top:20px;font-size:12px;line-height:1.7}
.demo-ctl{position:fixed;right:16px;bottom:16px;z-index:80;font-size:13px}
.demo-ctl .dc-btn{background:var(--dark);color:var(--dink);border:1px solid var(--dline);border-radius:999px;padding:10px 18px;font-weight:700;font-size:12.5px;box-shadow:0 8px 24px rgba(0,0,0,.25)}
.dc-menu{display:none;position:absolute;right:0;bottom:48px;background:var(--dark);border:1px solid var(--dline);border-radius:14px;padding:10px;width:250px;box-shadow:0 12px 34px rgba(0,0,0,.35)}
.dc-menu.show{display:block}
.dc-menu .ttl{font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--dmut);padding:6px 10px}
.dc-menu button{display:block;width:100%;text-align:left;background:transparent;border:none;color:var(--dink);font-size:13.5px;font-weight:600;padding:9px 10px;border-radius:8px}
.dc-menu button:hover{background:var(--dark3)}
.mbar{display:none;position:fixed;left:0;right:0;bottom:0;z-index:70;background:rgba(255,255,255,.97);border-top:1px solid var(--line);padding:10px 14px;gap:10px;backdrop-filter:blur(8px)}
.mbar .btn{flex:1}
.hide{display:none!important}
:focus-visible{outline:2.5px solid var(--red);outline-offset:2px}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}

/* ============ RESPONSIVE ============ */
@media(max-width:1020px){
  .hero-grid,.th-pane.on,.ex-pane.on,.mount-grid,.pb-grid,.lab-grid,.ent-grid,.book-grid{grid-template-columns:1fr}
  .proof{grid-template-columns:1fr 1fr}
  .steps{grid-template-columns:repeat(3,1fr)}
  .foot-grid{grid-template-columns:1fr 1fr}
  .reco-bd{grid-template-columns:1fr;}
  .reco-img{max-width:220px}
  .hdr-nav{display:none}
}
@media(max-width:640px){
  section.mod{padding:56px 0}
  .wrap{padding:0 18px}
  .f-grid{grid-template-columns:1fr}
  .steps{grid-template-columns:1fr 1fr}
  .proof{grid-template-columns:1fr 1fr}
  .stage-meta{grid-template-columns:1fr 1fr}
  .bk-g2{grid-template-columns:1fr}
  .mbar{display:flex}
  .hdr-hot{display:none}
  .foot{padding-bottom:130px}
  .demo-ctl{bottom:76px}
}
</style>
</head>
<body>
<!-- ================= M00 · DEMO BANNER ================= -->
<div class="banner-demo"><b>BẢN DEMO NỘI BỘ V1 — Beam Studio Commerce Pillar</b> · Data thật thu thập 05/08/2026 từ auto365.vn, x-light.vn · Ảnh vùng sáng là mô phỏng có gắn nhãn · Mục "chờ xác nhận" chưa đủ điều kiện lên production</div>

<!-- ================= M01 · GLOBAL HEADER ================= -->
<header class="hdr">
  <div class="wrap hdr-in">
    <a class="logo" href="#top">AUTO<b>365</b><small>HỆ THỐNG ĐỘ XE</small></a>
    <nav class="hdr-nav">
      <a href="#">Trang chủ</a>
      <a href="#">Ánh sáng</a>
      <a href="#grid" style="color:var(--red)">Đèn gầm dạng rời</a>
      <a href="#cases">Xe đã lắp</a>
      <a href="#booking">Đặt lịch</a>
    </nav>
    <span class="hdr-sp"></span>
    <div class="hdr-hot">Nâng cấp đèn &amp; phụ kiện<b>0365 365 911</b></div>
    <a class="btn btn-p btn-s" href="#beammatch">Chọn cấu hình</a>
  </div>
</header>
<nav class="subnav" aria-label="Điều hướng trong trang">
  <div class="subnav-in">
    <a href="#beammatch">⚡ Chọn cấu hình</a>
    <a href="#grid">Sản phẩm</a>
    <a href="#theatre">Beam Studio</a>
    <a href="#mounting">Vị trí lắp</a>
    <a href="#price">Giá</a>
    <a href="#compare">So sánh</a>
    <a href="#cases">Xe đã lắp</a>
    <a href="#faq">FAQ</a>
    <a href="#booking">Đặt lịch</a>
  </div>
</nav>
<div class="ctx-banner" id="ctxBanner"></div>

<!-- ================= M02 · BREADCRUMB ================= -->
<div class="wrap">
  <nav class="crumbs" aria-label="Breadcrumb"><a href="https://auto365.vn/">Trang chủ</a> › <a href="https://auto365.vn/nang-cap-anh-sang">Ánh sáng</a> › <b>Đèn Gầm dạng rời</b></nav>
</div>

<!-- ================= M03 · HERO BEAM STAGE ================= -->
<section class="hero" id="top">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="hero-hook">Không phải đoạn đường nào cũng đủ sáng. Và không phải bộ đèn nào sáng hơn cũng là đúng.</p>
      <h1 class="h1">Đèn Gầm dạng rời</h1>
      <p class="hero-sub">Đèn trợ sáng dạng rời cho ô tô — chọn theo <b>cung đường</b>, <b>kiểu vùng sáng</b>, <b>vị trí lắp</b> và <b>hệ điện</b> của xe.</p>
      <div class="hero-ctas">
        <a class="btn btn-p" href="#beammatch">Chọn cấu hình theo cung đường</a>
        <a class="btn btn-o" href="#grid">Xem 5 sản phẩm</a>
        <a class="btn btn-g" href="#cases">Xem xe đã lắp →</a>
      </div>
      <p class="hero-note">Một đề xuất chính cho mỗi nhu cầu — không trả về danh sách để anh chị tự đoán thông số.</p>
    </div>

    <div class="stage">
      <div class="stage-vis">
        <svg id="stageSvg" viewBox="0 0 640 400" role="img" aria-label="Mô phỏng vùng sáng trên đường ban đêm" style="color:#ffe7c2">
          <defs>
            <linearGradient id="gsky" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#04060a"/><stop offset="1" stop-color="#0d1420"/>
            </linearGradient>
            <linearGradient id="groad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#11151c"/><stop offset="1" stop-color="#1a1f28"/>
            </linearGradient>
            <linearGradient id="gbeamV" x1="0" y1="1" x2="0" y2="0">
              <stop offset="0" stop-color="currentColor" stop-opacity=".55"/>
              <stop offset=".8" stop-color="currentColor" stop-opacity=".12"/>
              <stop offset="1" stop-color="currentColor" stop-opacity="0"/>
            </linearGradient>
            <radialGradient id="gpool" cx=".5" cy=".5" r=".5">
              <stop offset="0" stop-color="currentColor" stop-opacity=".5"/>
              <stop offset="1" stop-color="currentColor" stop-opacity="0"/>
            </radialGradient>
          </defs>
          <!-- sky + treeline -->
          <rect x="0" y="0" width="640" height="242" fill="url(#gsky)"/>
          <path d="M0,242 L0,225 L60,231 L120,220 L200,233 L290,224 L360,232 L450,222 L530,233 L600,226 L640,231 L640,242 Z" fill="#080b10"/>
          <!-- road -->
          <rect x="0" y="242" width="640" height="158" fill="#0c0f15"/>
          <polygon points="55,400 302,242 338,242 585,400" fill="url(#groad)"/>
          <polygon points="55,400 302,242 306,242 75,400" fill="#262d38"/>
          <polygon points="565,400 334,242 338,242 585,400" fill="#262d38"/>
          <polygon points="317,400 319,338 321,338 323,400" fill="#39414d"/>
          <polygon points="318.4,322 319.6,296 320.8,296 321.8,322" fill="#39414d"/>
          <polygon points="319.2,286 319.8,271 320.6,271 321,286" fill="#333a45"/>
          <polygon points="319.6,264 320,254 320.5,254 320.8,264" fill="#2c333d"/>
          <!-- reflector posts -->
          <g fill="#20262f">
            <rect x="120" y="330" width="5" height="26"/><rect x="212" y="288" width="4" height="18"/><rect x="266" y="262" width="3" height="12"/>
            <rect x="512" y="330" width="5" height="26"/><rect x="424" y="288" width="4" height="18"/><rect x="372" y="262" width="3" height="12"/>
          </g>
          <g fill="#c9a05a" opacity=".8">
