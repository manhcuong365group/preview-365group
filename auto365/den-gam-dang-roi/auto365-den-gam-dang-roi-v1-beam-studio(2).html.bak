<!-- ================= M06 · BEAMMATCH ENGINE ================= -->
<section class="mod mod-soft" id="beammatch">
  <div class="wrap">
    <div class="mod-head">
      <div class="mod-tag">M06 · BeamMatch Engine</div>
      <h2 class="mt">Chọn cấu hình ánh sáng theo hành trình</h2>
      <p class="mod-lede">Trả lời 5 câu hỏi. Auto365 trả về <b>một cấu hình chính</b> — kèm hai phương án gập lại để đối chiếu. Thông số kỹ thuật vẫn có, nhưng nằm ở lớp giải thích sau.</p>
    </div>

    <div class="bm-resume" id="bmResume">
      <span>↩ Tiếp tục cấu hình lần trước: <b>Ford EcoSport — vị trí hốc biển số</b></span>
      <button class="btn btn-s btn-o" id="bmResumeBtn">Tiếp tục</button>
    </div>

    <div class="bm" id="bmCard">
      <div class="bm-top">
        <div class="bm-steps" aria-hidden="true">
          <div class="bm-st done" data-st="1"></div>
          <div class="bm-st" data-st="2"></div>
          <div class="bm-st" data-st="3"></div>
          <div class="bm-st" data-st="4"></div>
          <div class="bm-st" data-st="5"></div>
        </div>
        <div class="bm-count" id="bmCount">Bước 1/5</div>
      </div>

      <div class="bm-body">
        <!-- STEP 1 -->
        <div class="bm-panel" data-panel="1">
          <div class="bm-q">Anh chị thường đi đâu nhất?</div>
          <div class="bm-hint">Chọn cung đường chiếm nhiều thời gian lái nhất — cấu hình sẽ ưu tiên tình huống này.</div>
          <div class="opt-grid">
            <button class="opt" data-step="1" data-val="pho"><span class="oi">🏙</span><span class="ot">Phố &amp; đường có đèn</span><span class="od">Chủ yếu nội đô, cần vùng gần sạch, không chói người đối diện.</span></button>
            <button class="opt" data-step="1" data-val="tinh"><span class="oi">🛣</span><span class="ot">Đường tỉnh thiếu sáng</span><span class="od">Đường hai chiều, ít đèn đường, nhiều xe máy cắt ngang.</span></button>
            <button class="opt" data-step="1" data-val="caotoc"><span class="oi">⏩</span><span class="ot">Cao tốc</span><span class="od">Tốc độ cao, cần chiều sâu quan sát và biển báo từ xa.</span></button>
            <button class="opt" data-step="1" data-val="deo"><span class="oi">⛰</span><span class="ot">Đường đèo</span><span class="od">Cua liên tục, cần sáng hai mép đường và vách núi.</span></button>
            <button class="opt" data-step="1" data-val="mua"><span class="oi">🌧</span><span class="ot">Mưa hoặc sương</span><span class="od">Cần ánh sáng vàng bám đường, giảm lóa ngược.</span></button>
            <button class="opt" data-step="1" data-val="offroad"><span class="oi">🚧</span><span class="ot">Công trường, bán tải, off-road</span><span class="od">Địa hình xấu, ưu tiên độ bền, chống nước, pát chắc.</span></button>
            <button class="opt" data-step="1" data-val="tai24"><span class="oi">🚚</span><span class="ot">Xe tải 24V</span><span class="od">Hệ điện 24V — chỉ một số sản phẩm tương thích.</span></button>
          </div>
        </div>

        <!-- STEP 2 -->
        <div class="bm-panel hide" data-panel="2">
          <div class="bm-q">Xe đang thiếu vùng sáng nào?</div>
          <div class="bm-hint">Nhìn theo sơ đồ từ trên xuống — xe ở dưới, hướng đi lên trên.</div>
          <div class="opt-grid">
            <button class="opt" data-step="2" data-val="gan">
              <svg viewBox="0 0 120 80"><rect width="120" height="80" fill="#0a0e14"/><polygon points="18,56 102,56 82,30 38,30" fill="#ffc46b" opacity=".5"/><rect x="52" y="56" width="16" height="18" rx="3" fill="#39414d"/><circle cx="55" cy="57" r="1.6" fill="#ffe7c2"/><circle cx="65" cy="57" r="1.6" fill="#ffe7c2"/></svg>
              <span class="ot">Thiếu vùng gần</span><span class="od">Ngay trước đầu xe tối, khó thấy ổ gà, vạch kẻ.</span>
            </button>
            <button class="opt" data-step="2" data-val="mep">
              <svg viewBox="0 0 120 80"><rect width="120" height="80" fill="#0a0e14"/><polygon points="10,56 42,56 30,22 12,26" fill="#ffc46b" opacity=".5"/><polygon points="78,56 110,56 108,26 90,22" fill="#ffc46b" opacity=".5"/><rect x="52" y="56" width="16" height="18" rx="3" fill="#39414d"/><circle cx="55" cy="57" r="1.6" fill="#ffe7c2"/><circle cx="65" cy="57" r="1.6" fill="#ffe7c2"/></svg>
              <span class="ot">Thiếu hai mép đường</span><span class="od">Khó quan sát lề, cua và người đi bộ sát mép.</span>
            </button>
            <button class="opt" data-step="2" data-val="xa">
              <svg viewBox="0 0 120 80"><rect width="120" height="80" fill="#0a0e14"/><polygon points="50,56 70,56 65,6 55,6" fill="#ffc46b" opacity=".55"/><rect x="52" y="56" width="16" height="18" rx="3" fill="#39414d"/><circle cx="55" cy="57" r="1.6" fill="#ffe7c2"/><circle cx="65" cy="57" r="1.6" fill="#ffe7c2"/></svg>
              <span class="ot">Thiếu tầm xa</span><span class="od">Đường trường không đủ chiều sâu, biển báo hiện muộn.</span>
            </button>
            <button class="opt" data-step="2" data-val="canbang">
              <svg viewBox="0 0 120 80"><rect width="120" height="80" fill="#0a0e14"/><polygon points="18,56 102,56 84,32 36,32" fill="#ffc46b" opacity=".4"/><polygon points="50,56 70,56 66,8 54,8" fill="#ffc46b" opacity=".5"/><rect x="52" y="56" width="16" height="18" rx="3" fill="#39414d"/><circle cx="55" cy="57" r="1.6" fill="#ffe7c2"/><circle cx="65" cy="57" r="1.6" fill="#ffe7c2"/></svg>
              <span class="ot">Muốn cân bằng</span><span class="od">Rộng gần và có thêm tầm xa — một cấu hình cho nhiều cung đường.</span>
            </button>
          </div>
        </div>

        <!-- STEP 3 -->
        <div class="bm-panel hide" data-panel="3">
          <div class="bm-q">Kiểu lắp mong muốn?</div>
          <div class="bm-hint">Đèn dạng rời là quyết định kỹ thuật — và cả thẩm mỹ. Chọn hướng anh chị muốn.</div>
          <div class="opt-grid">
            <button class="opt" data-step="3" data-val="hocgio"><span class="oi">🕳</span><span class="ot">Giấu kín trong hốc gió</span><span class="od">Ưu tiên nhìn zin, thân đèn gần như không lộ.</span></button>
            <button class="opt" data-step="3" data-val="bienso"><span class="oi">🔢</span><span class="ot">Lắp tại hốc biển số</span><span class="od">Vị trí trung tâm, kín đáo, dễ căn góc chiếu.</span></button>
            <button class="opt" data-step="3" data-val="can"><span class="oi">🛡</span><span class="ot">Lắp tại cản trước</span><span class="od">Thoáng, tản nhiệt tốt, dễ thi công pát.</span></button>
            <button class="opt" data-step="3" data-val="lo"><span class="oi">👁</span><span class="ot">Chấp nhận lộ thân đèn</span><span class="od">Ưu tiên hiệu năng và góc chiếu tối ưu.</span></button>
            <button class="opt" data-step="3" data-val="khongkhoan"><span class="oi">🔩</span><span class="ot">Ưu tiên không khoan cản</span><span class="od">Chỉ dùng pát bắt vào điểm có sẵn, giữ nguyên bản.</span></button>
            <button class="opt" data-step="3" data-val="chuabiet"><span class="oi">❓</span><span class="ot">Chưa biết — cần Auto365 kiểm tra</span><span class="od">Kỹ thuật sẽ khảo sát đầu xe và tư vấn vị trí.</span></button>
          </div>
        </div>

        <!-- STEP 4 -->
        <div class="bm-panel hide" data-panel="4">
          <div class="bm-q">Xe và hệ điện</div>
          <div class="bm-hint">Nếu xe đã có trong Mounting Index, hệ thống chuyển thẳng sang lane đã xác minh.</div>
          <div class="f-grid" style="margin-bottom:18px">
            <label class="field">Hãng xe
              <select id="fHang">
                <option value="">— Chọn hãng —</option>
                <option>VinFast</option><option>Ford</option><option>Toyota</option><option>Kia</option><option>Hyundai</option><option>Mazda</option><option>Mitsubishi</option><option>Honda</option><option>Isuzu</option><option>Nissan</option><option>Suzuki</option><option>Xe tải / đầu kéo</option><option>Khác</option>
              </select>
            </label>
            <label class="field">Dòng xe
              <input id="fDong" list="dongxe" placeholder="VD: EcoSport, VF8, Ranger…">
              <datalist id="dongxe">
                <option value="VF8"></option><option value="EcoSport"></option><option value="Ranger"></option><option value="Everest"></option><option value="Fortuner"></option><option value="Carens"></option><option value="Xpander"></option><option value="CX-5"></option><option value="Santa Fe"></option>
              </datalist>
            </label>
            <label class="field">Năm sản xuất
              <select id="fNam"></select>
            </label>
          </div>
          <div style="display:grid;gap:14px">
            <div class="field">Kiểu thân xe
              <div class="chiprow" data-chip="than">
                <button class="chip" data-val="sedan">Sedan</button><button class="chip" data-val="suv">SUV / CUV</button><button class="chip" data-val="bantai">Bán tải</button><button class="chip" data-val="mpv">MPV</button><button class="chip" data-val="hatch">Hatchback</button><button class="chip" data-val="tai">Xe tải</button>
              </div>
            </div>
            <div class="field">Hệ điện
              <div class="chiprow" data-chip="dien">
                <button class="chip sel" data-val="12">12V</button><button class="chip" data-val="24">24V</button><button class="chip" data-val="unk">Không rõ</button>
              </div>
            </div>
            <div class="field">Cản / mặt ca-lăng
              <div class="chiprow" data-chip="can">
                <button class="chip sel" data-val="zin">Nguyên bản</button><button class="chip" data-val="do">Đã độ / thay</button><button class="chip" data-val="unk">Không rõ</button>
              </div>
            </div>
          </div>
        </div>

        <!-- STEP 5 -->
        <div class="bm-panel hide" data-panel="5">
          <div class="bm-q">Ngân sách dự kiến cho phần đèn</div>
          <div class="bm-hint">Giá sản phẩm chưa gồm pát, dây và công lắp — phần đó khóa sau khi kiểm tra xe.</div>
          <div class="opt-grid">
