    <button data-dc="ads">🎯 Ads — ?model=xlight-f30-ultra</button>
    <button data-dc="fb">📱 Facebook — ?case=vf8-m30-ultra-v2</button>
    <button data-dc="return">↩ Khách quay lại</button>
    <button data-dc="reset">✕ Reset</button>
  </div>
  <button class="dc-btn" id="dcBtn">⚙ Demo</button>
</div>
<script>
/* ============ helpers ============ */
function $(s,c){return (c||document).querySelector(s)}
function $$(s,c){return Array.from((c||document).querySelectorAll(s))}
function phswap(img,label){
  var d=document.createElement('div');d.className='ph';d.textContent=label;
  img.replaceWith(d);
}

/* ============ HERO BEAM STAGE ============ */
var stageSvg=$('#stageSvg');
$$('.stab').forEach(function(b){
  b.addEventListener('click',function(){
    $$('.stab').forEach(function(x){x.classList.remove('on')});
    b.classList.add('on');
    ['before','cos','pha','combo'].forEach(function(m){
      $('#beam-'+m).style.display=(m===b.dataset.beam)?'':'none';
    });
  });
});
$$('.ktab').forEach(function(b){
  b.addEventListener('click',function(){
    $$('.ktab').forEach(function(x){x.classList.remove('on')});
    b.classList.add('on');
    stageSvg.style.color=b.dataset.k;
  });
});

/* ============ PRODUCT DATA (SSOT demo — nguồn: auto365.vn / x-light.vn 05/08/2026) ============ */
var P={
  f30:{name:'X-Light F30 Ultra',price:4800000,unit:'/bộ · chưa VAT',bh:'24 tháng',volt:'Chờ xác nhận (chưa công bố)',
    beam:'Phủ gần rộng + Bù Cos dải giữa',opt:'2 nguồn Cos (6+6) + Bù Cos + Pha ~95W',
    kelvin:'6500K · 5500/3000K · 3000K',url:'https://auto365.vn/x-light-f30-ultra',
    img:'https://auto365.vn/uploads/images/products/auto365vn-artboard-6jpg-img_6a3f378249dc57.58687412_auto365vn-1782527874-0.jpg'},
  m30v2:{name:'Titan Moto M30 Ultra V2',price:5500000,unit:'/cặp · chưa VAT',bh:'18 tháng',volt:'12–16V',
    beam:'Cân bằng: rộng gần + bổ sung chiều sâu',opt:'3+3+3 · lens liền khối · Cos ~70W / Pha ~95W',
    kelvin:'4800/3000K · 5500K',url:'https://auto365.vn/den-tro-sang-titan-moto-m30-ultra-v2',
    img:'https://auto365.vn/uploads/images/products/auto365vn-den-tro-sang-titan-moto-m30-ultra-v2-1jpg-img_6940c1397f5b77.26668705_auto365vn-1765851449-0.jpg'},
  m40:{name:'Titan M40 Ultra V2',price:6500000,unit:'/bộ · chưa VAT',bh:'24 tháng',volt:'12/24V (theo công bố)',
    beam:'Đa tầng hiệu năng cao — chiều sâu lớn nhất danh mục',opt:'Dual Cup · Dual Direct Beam · Cos ~80W / Pha ~110W',
    kelvin:'5500/3000 · 4800/3000 · 3000K',url:'https://auto365.vn/den-tro-sang-titan-m40-ultra-v2',
    img:'https://auto365.vn/uploads/images/products/auto365vn-den-tro-sang-titan-m40-ultra-v2-14jpg-img_6a1e4290e77b10.42371326_auto365vn-1780368016-0.jpg'},
  m30u:{name:'Titan M30 Ultra',price:4500000,unit:'/cặp',bh:'12 tháng · kích hoạt điện tử',volt:'12V',
    beam:'Khởi điểm 2 màu — cắt sáng gọn, hạn chế chói',opt:'140W/bộ · 9 LED vàng + 9 trắng · 6000K/3000K chuyển',
    kelvin:'6000K/3000K chuyển chế độ',url:'https://auto365.vn/den-tro-sang-titan-m30-ultra',
    img:'https://auto365.vn/uploads/images/product/TITAN/den-tro-sang-titan-m30-ultra/Artboard%203.jpg'}
};
function vnd(n){return n.toLocaleString('vi-VN')+' ₫'}

/* ============ BEAMMATCH ============ */
var bmStep=1,bmState={},bmChips={dien:'12',can:'zin'};
var pkgName={pho:'Gói Phủ Gần Đô Thị',tinh:'Gói Ánh Sáng Cân Bằng Đường Tỉnh',caotoc:'Gói Chiều Sâu Cao Tốc',deo:'Gói Hai Lớp Sáng Đường Đèo',mua:'Gói Ánh Vàng Mưa & Sương',offroad:'Gói Bền Bỉ Công Trường & Bán Tải',tai24:'Gói Xe Tải 24V'};
var posName={hocgio:'Hốc gió (giấu kín)',bienso:'Hốc biển số',can:'Cản trước',lo:'Vị trí tối ưu góc chiếu (chấp nhận lộ)',khongkhoan:'Điểm bắt sẵn — không khoan cản',chuabiet:'Kỹ thuật khảo sát & tư vấn'};

$$('.opt').forEach(function(o){
  o.addEventListener('click',function(){
    var st=o.dataset.step;
    $$('.opt[data-step="'+st+'"]').forEach(function(x){x.classList.remove('sel')});
    o.classList.add('sel');
    bmState[st]=o.dataset.val;
    updateBmNav();
  });
});
$$('[data-chip]').forEach(function(g){
  var key=g.dataset.chip;
  $$('.chip',g).forEach(function(c){
    c.addEventListener('click',function(e){
      e.preventDefault();
      $$('.chip',g).forEach(function(x){x.classList.remove('sel')});
      c.classList.add('sel');bmChips[key]=c.dataset.val;
    });
  });
});
var selNam=$('#fNam');
(function(){var o='<option value="">— Năm —</option>';for(var y=2026;y>=2008;y--)o+='<option>'+y+'</option>';selNam.innerHTML=o})();
$('#fHang').addEventListener('change',updateBmNav);
$('#fDong').addEventListener('input',updateBmNav);

function stepOk(){
  if(bmStep===4)return !!$('#fHang').value||!!$('#fDong').value.trim();
  return !!bmState[bmStep];
}
function updateBmNav(){
  $('#bmCount').textContent='Bước '+bmStep+'/5';
  $$('.bm-st').forEach(function(s,i){s.classList.toggle('done',i<bmStep)});
  $('#bmBack').disabled=bmStep===1;
  var next=$('#bmNext');
  next.disabled=!stepOk();
  next.textContent=bmStep===5?'Xem cấu hình đề xuất →':'Tiếp tục →';
  var lbl={1:'cung đường',2:'vùng sáng',3:'kiểu lắp',4:'xe & hệ điện',5:'ngân sách'};
  $('#bmPick').textContent=stepOk()?'':('Chọn '+lbl[bmStep]+' để tiếp tục');
}
function showStep(n){
  bmStep=n;
  $$('.bm-panel').forEach(function(p){p.classList.toggle('hide',p.dataset.panel!=String(n))});
  updateBmNav();
}
$('#bmBack').addEventListener('click',function(){if(bmStep>1)showStep(bmStep-1)});
$('#bmNext').addEventListener('click',function(){
  if(!stepOk())return;
  if(bmStep<5){showStep(bmStep+1)}
  else{renderReco()}
});

function scoreProducts(){
  var s={f30:0,m30v2:0,m40:0,m30u:0};
  var add=function(k,v){s[k]+=v};
  var m1=bmState[1],m2=bmState[2],m5=bmState[5];
  if(m1==='pho'){add('f30',2);add('m30u',2);add('m30v2',1)}
  if(m1==='tinh'){add('m30v2',3);add('f30',2);add('m40',1)}
  if(m1==='caotoc'){add('m40',3);add('m30v2',1)}
  if(m1==='deo'){add('m40',2);add('m30v2',2);add('f30',1)}
  if(m1==='mua'){add('m30u',2);add('f30',2);add('m30v2',1)}
  if(m1==='offroad'){add('m40',3);add('m30v2',1)}
  if(m2==='gan'){add('f30',3);add('m30u',1)}
  if(m2==='mep'){add('m30v2',2);add('m30u',2);add('f30',1)}
  if(m2==='xa'){add('m40',3);add('m30v2',1)}
  if(m2==='canbang'){add('m30v2',3);add('m40',1);add('f30',1)}
  if(m5==='d5'){add('m30u',3);add('f30',2);add('m30v2',-1);add('m40',-3)}
  if(m5==='56'){add('m30v2',2);add('f30',1);add('m40',-1)}
  if(m5==='t6'){add('m40',3)}
  if(m1==='tai24'||bmChips.dien==='24'){s.m40+=100;s.f30-=100;s.m30v2-=100;s.m30u-=100}
  return Object.keys(s).sort(function(a,b){return s[b]-s[a]});
}
function carKey(){
  var t=(($('#fDong').value||'')+' '+($('#fHang').value||'')).toLowerCase();
  if(t.indexOf('ecosport')>-1)return 'ecosport';
  if(t.indexOf('vf8')>-1||t.indexOf('vf 8')>-1)return 'vf8';
  return null;
}
var verified={ecosport:{p:'m40',xe:'Ford EcoSport',pos:'Hốc biển số',caseId:'cs-eco'},vf8:{p:'m30v2',xe:'VinFast VF8',pos:'Cản trước',caseId:'cs-vf8'}};

function renderReco(){
  var order=scoreProducts(),main=order[0],alts=order.slice(1,3);
  var mp=P[main],m1=bmState[1],ck=carKey(),vf=ck?verified[ck]:null;
  var green=vf&&vf.p===main;
  var pos=green?vf.pos+' — theo case '+vf.xe:posName[bmState[3]]||'Xác nhận theo xe';
  var kel=m1==='mua'?'Ưu tiên phiên bản có 3000K (vàng)':(m1==='pho'?'Trắng hoặc phiên bản kép':'Phiên bản kép trắng/vàng theo cung đường');
  var xeTxt=[$('#fHang').value,$('#fDong').value,$('#fNam').value].filter(Boolean).join(' ')||'xe của anh chị';
  var why='';
  if(m1==='tai24'||bmChips.dien==='24'){why='Hệ điện 24V loại gần hết danh mục — <b>'+mp.name+'</b> là mẫu duy nhất công bố hỗ trợ 12/24V. Vẫn cần kiểm tra hệ điện thực tế trước khi thi công.'}
  else if(green){why='<b>'+vf.xe+'</b> đã có case lắp thật với <b>'+mp.name+'</b> tại vị trí '+vf.pos.toLowerCase()+' — cấu hình này đi lane xanh: vị trí và phương án đã được xác minh, chỉ còn chốt giá pát và công tại chi nhánh.'}
  else{why='Với cung đường đã chọn, <b>'+mp.name+'</b> cho đúng kiểu vùng sáng đang thiếu ('+mp.beam.toLowerCase()+'). Hai phương án bên dưới đổi mức chi phí lấy vùng sáng khác — xem để đối chiếu, không bắt buộc.'}
  if(vf&&vf.p!==main){why+='<br><span class="tag b-ok" style="margin-top:8px;white-space:normal;line-height:1.5;text-transform:none;letter-spacing:0">✔ '+vf.xe+' đã có case xác minh với '+P[vf.p].name+' tại '+vf.pos.toLowerCase()+' — xem phương án gập bên dưới hoặc đọc case</span>'}
  var laneHtml=green
    ?'<span class="lane lane-g">● Lane xanh — vị trí đã xác minh theo Case Log</span>'
    :'<span class="lane lane-y">● Lane vàng — cần xác nhận pát theo xe</span>';
  var ctas=green
    ?'<a class="btn btn-p" href="#booking">Đặt lịch lắp tại chi nhánh</a><a class="btn btn-o" href="#'+vf.caseId+'" onclick="hlCase(\''+vf.caseId+'\')">Xem case '+vf.xe+'</a>'
    :'<a class="btn btn-p" href="#booking" onclick="preBooking(true)">Gửi ảnh đầu xe để khóa vị trí và giá</a><a class="btn btn-o" href="#booking" onclick="preBooking(false)">Đặt lịch kiểm tra tại chi nhánh</a>';
  var altHtml=alts.map(function(k){
    var a=P[k];
    var lbl=a.price<mp.price?'Tiết kiệm hơn':'Hiệu năng cao hơn';
    if(k==='m40'&&mp.price>a.price)lbl='Hiệu năng cao hơn';
    return '<details class="alt"><summary><span class="tag">'+lbl+'</span> '+a.name+' — '+vnd(a.price)+'<small style="color:var(--muted);font-weight:500">'+a.unit+'</small></summary><div class="alt-bd"><img src="'+a.img+'" alt="'+a.name+'" loading="lazy" onerror="phswap(this,\''+a.name.split(' ')[1]+'\')"><div><p style="margin-bottom:6px"><b>'+a.beam+'</b></p><p style="margin-bottom:6px">'+a.opt+'</p><p style="color:var(--muted);font-size:13px">Nhiệt màu: '+a.kelvin+' · Điện áp: '+a.volt+' · BH '+a.bh+'</p><a class="btn btn-g" style="padding-left:0" href="'+a.url+'" target="_blank" rel="noopener">Chi tiết trên auto365.vn ↗</a></div></div></details>';
  }).join('');
  $('#reco').innerHTML=
    '<div class="reco-card">'+
      '<div class="reco-hd"><div style="flex:1"><div class="k">Một đề xuất chính cho '+xeTxt+'</div><h3>'+(pkgName[m1]||'Cấu hình đề xuất')+'</h3></div>'+laneHtml+'</div>'+
      '<div class="reco-bd">'+
        '<div class="reco-img"><img src="'+mp.img+'" alt="'+mp.name+'" loading="lazy" onerror="phswap(this,\''+mp.name+'\')"></div>'+
        '<div class="reco-spec">'+
          '<div><span>Sản phẩm</span><b>'+mp.name+'</b></div>'+
          '<div><span>Kiểu vùng sáng</span><b>'+mp.beam+'</b></div>'+
          '<div><span>Cấu trúc quang học</span><b>'+mp.opt+'</b></div>'+
          '<div><span>Vị trí dự kiến</span><b>'+pos+'</b></div>'+
          '<div><span>Điện áp</span><b>'+mp.volt+'</b></div>'+
          '<div><span>Nhiệt màu đề xuất</span><b>'+kel+'</b></div>'+
          '<div><span>Giá sản phẩm</span><b>'+vnd(mp.price)+' <small style="font-weight:500;color:var(--muted)">'+mp.unit+'</small></b></div>'+
          '<div><span>Tổng giá lắp</span><b>'+(green?'Chốt tại chi nhánh — vị trí đã xác minh':'Chờ kiểm tra xe / ảnh đầu xe')+'</b></div>'+
          '<div class="reco-why">'+why+'</div>'+
        '</div>'+
      '</div>'+
      '<div class="reco-ctas">'+ctas+'</div>'+
    '</div>'+altHtml+
    '<p style="font-size:12.5px;color:var(--muted);margin-top:12px">Đề xuất dựa trên thông số công bố và case đã xác minh — không phải cam kết kỹ thuật cuối. Quyết định lắp chỉ chốt sau khi kiểm tra xe thật.</p>';
  $('#reco').classList.add('show');
  $('#reco').scrollIntoView({behavior:'smooth',block:'start'});
}
function preBooking(withPhoto){
  var xe=[$('#fHang').value,$('#fDong').value,$('#fNam').value].filter(Boolean).join(' ');
  if(xe)$('#bkXe').value=xe;
  if(withPhoto){$('#bkUpl').checked=true;$('#uplBox').classList.add('show');$('#bkNeed').selectedIndex=2}
}
function hlCase(id){
  $$('.ccard').forEach(function(c){c.classList.remove('hl')});
  var el=document.getElementById(id);if(el)el.classList.add('hl');
}
updateBmNav();

/* ============ PRODUCT GRID FILTER ============ */
$$('#pfilters .chip').forEach(function(c){
  c.addEventListener('click',function(){
    $$('#pfilters .chip').forEach(function(x){x.classList.remove('sel')});
    c.classList.add('sel');
    var f=c.dataset.f;
    $$('.pcard').forEach(function(p){
      var tags=p.dataset.tags.split(' ');
      var show=f==='all'||tags.indexOf(f)>-1||(f==='titan'&&tags.indexOf('titan')>-1);
      p.style.display=show?'':'none';
    });
  });
});

/* ============ THEATRE + EXPLODED TABS ============ */
function bindTabs(tabSel,paneSel,attr,pattr){
  $$(tabSel).forEach(function(t){
    t.addEventListener('click',function(){
      $$(tabSel).forEach(function(x){x.classList.remove('on')});
      t.classList.add('on');
      $$(paneSel).forEach(function(p){p.classList.toggle('on',p.dataset[pattr]===t.dataset[attr])});
    });
  });
}
bindTabs('.th-tab[data-tp]','.th-pane','tp','pane');
bindTabs('.th-tab[data-ex]','.ex-pane','ex','expane');
$$('[data-th]').forEach(function(a){
  a.addEventListener('click',function(){
    var t=$('.th-tab[data-tp="'+a.dataset.th+'"]');
    if(t)t.click();
  });
});

/* ============ MOUNTING STUDIO ============ */
var MOUNT={
  A:{t:'A · Hốc biển số',s:'Vị trí trung tâm, kín đáo, dễ căn góc chiếu',rows:[
    ['Mức kín đáo','Cao — nằm sau mép cản, nhìn thẳng mới thấy'],
    ['Bảo vệ đèn','Tốt — khuất đá văng trực diện'],
    ['Chiều cao & góc chiếu','Trung bình, gần trục giữa — dễ căn đối xứng'],
    ['Yêu cầu pát','Pát riêng theo xe / nẹp vùng biển số'],
    ['Khả năng giữ zin','Cao với nhiều xe — xác nhận theo đời xe'],
    ['Phương án đi dây','Theo khoang két nước lên bình điện'],
    ['Giới hạn','Bề ngang hẹp — footprint đèn phải vừa hốc']],
    ok:'✔ Đã xác minh: Ford EcoSport · Titan M40 Ultra V2',okCls:'b-ok',link:'#cs-eco'},
  B:{t:'B · Hốc gió bên',s:'Giấu trong hốc gió cản — phương án "zin" nhất',rows:[
    ['Mức kín đáo','Rất cao — gần như không lộ thân đèn'],
    ['Bảo vệ đèn','Khá — khuất trong hốc'],
    ['Chiều cao & góc chiếu','Thấp — cần kiểm tra mép hốc có che chùm sáng'],
    ['Yêu cầu pát','Pát riêng theo hốc, có thể cần gia công'],
    ['Khả năng giữ zin','Trung bình — tùy xe phải tháo ốp'],
    ['Phương án đi dây','Ngắn, đi theo mép cản bên'],
    ['Giới hạn','Hai đèn hai hốc — phải căn đều hai bên']],
    ok:'Chờ xác minh — chưa có case công khai',okCls:'b-wait',link:'#booking'},
  C:{t:'C · Cản trước',s:'Thoáng, tản nhiệt tốt, dễ thi công và căn chỉnh',rows:[
    ['Mức kín đáo','Thấp — thân đèn lộ có chủ đích'],
    ['Bảo vệ đèn','Cần IP68 + pát chắc — hứng đá văng nhiều hơn'],
    ['Chiều cao & góc chiếu','Chủ động nhất — ít bị che chắn'],
    ['Yêu cầu pát','Pát bắt vào cản/xương cản; có thể cần khoan'],
    ['Khả năng giữ zin','Tùy phương án — báo trước nếu phải khoan'],
    ['Phương án đi dây','Thẳng lên khoang máy, dễ bảo trì'],
    ['Giới hạn','Thẩm mỹ phụ thuộc kiểu cản từng xe']],
    ok:'✔ Đã xác minh: VinFast VF8 · Titan Moto M30 Ultra V2',okCls:'b-ok',link:'#cs-vf8'},
  D:{t:'D · Sau mặt ca-lăng',s:'Kín đáo nhất — nhưng phụ thuộc khe nan ca-lăng',rows:[
    ['Mức kín đáo','Cao nhất — đèn nằm sau nan'],
    ['Bảo vệ đèn','Tốt'],
    ['Chiều cao & góc chiếu','Bị ràng buộc bởi khe nan — phải test thực tế'],
    ['Yêu cầu pát','Pát riêng vào xương sau ca-lăng'],
    ['Khả năng giữ zin','Cao nếu không cắt nan; thấp nếu phải cắt'],
    ['Phương án đi dây','Ngắn nhất — sát khoang máy'],
    ['Giới hạn','Nan che một phần chùm sáng; tản nhiệt kém thoáng hơn']],
    ok:'Chờ xác minh — chưa có case công khai',okCls:'b-wait',link:'#booking'}
};
function showMount(k){
  var d=MOUNT[k];
  $('#mpTitle').textContent=d.t;$('#mpSub').textContent=d.s;
  $('#mpRows').innerHTML=d.rows.map(function(r){return '<div><span>'+r[0]+'</span><b>'+r[1]+'</b></div>'}).join('');
  $('#mpFoot').innerHTML='<span class="tag '+d.okCls+'">'+d.ok+'</span> <a class="btn btn-s btn-o" href="'+d.link+'">'+(d.okCls==='b-ok'?'Xem case':'Gửi ảnh xe để kiểm tra')+'</a>';
  $$('.hs').forEach(function(h){h.classList.toggle('on',h.id==='hs'+k)});
}
$$('.hs').forEach(function(h){
  var k=h.id.replace('hs','');
  h.addEventListener('click',function(){showMount(k)});
  h.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();showMount(k)}});
});
showMount('A');
$('#aesHide').addEventListener('click',function(){
  this.classList.add('sel');$('#aesPerf').classList.remove('sel');
  ['A','B','D'].forEach(function(k){$('#hs'+k).classList.remove('dim')});
  $('#hsC').classList.add('dim');
});
$('#aesPerf').addEventListener('click',function(){
  this.classList.add('sel');$('#aesHide').classList.remove('sel');
  ['C','A'].forEach(function(k){$('#hs'+k).classList.remove('dim')});
  ['B','D'].forEach(function(k){$('#hs'+k).classList.add('dim')});
});

/* ============ PRICE BUILDER ============ */
var pbLocked=false;
function renderPB(){
  var k=$('#pbSelect').value,p=P[k]||{name:'Titan Moto M10 Ultra V3',price:2000000,unit:'/cặp · chưa VAT'};
  if(k==='m10')p={name:'Titan Moto M10 Ultra V3',price:2000000,unit:'/cặp · chưa VAT'};
  var wait=function(txt){return '<span class="v wait">⏳ '+txt+'</span>'};
  var lock=function(){return '<span class="v" style="color:var(--muted)">••• ₫ <span class="tag b-demo" style="margin-left:6px">SSOT</span></span>'};
  var rows=[
    ['Đèn '+(p.unit.indexOf('cặp')>-1?'/cặp':'/bộ'),'<small>'+p.name+' — giá niêm yết</small>','<span class="v">'+vnd(p.price)+'</span>'],
    ['Pát theo xe','<small>Theo điểm bắt thực tế trên xe</small>',pbLocked?lock():wait('Chờ kiểm tra xe')],
    ['Dây · relay · cầu chì','<small>Theo tải Cos/Pha và vị trí bình điện</small>',pbLocked?lock():wait('Chờ kiểm tra xe')],
    ['Công đi dây · lắp · căn chỉnh','<small>Theo mức độ tháo lắp của xe</small>',pbLocked?lock():wait('Chờ kiểm tra xe')],
    ['VAT','<small>Theo hóa đơn tại thời điểm thanh toán</small>',pbLocked?lock():wait('Tính khi khóa giá')]
  ];
  $('#pbRows').innerHTML=rows.map(function(r){return '<div class="pb-row"><div class="l">'+r[0]+r[1]+'</div>'+r[2]+'</div>'}).join('');
  $('#pbTotalLabel').textContent=pbLocked?'Tổng trọn gói (đã khóa)':'Tổng dự kiến';
  $('#pbTotal').textContent=pbLocked?'Hiển thị từ Pricing SSOT':'Chờ kiểm tra xe';
  $('#pbNote').innerHTML=pbLocked
    ?'Trạng thái <b>Giá đã khóa</b> (ví dụ hiển thị): con số thật chỉ render từ Pricing SSOT sau khi kỹ thuật xác nhận xe — demo không tự bịa số, kể cả số minh họa.'
    :'Trạng thái <b>Giá cần xác nhận</b>: pát theo xe, phương án đi dây, công xử lý vị trí lắp và VAT chỉ khóa sau khi kỹ thuật kiểm tra xe hoặc nhận đủ 3 ảnh đầu xe.';
}
$('#pbSelect').addEventListener('change',renderPB);
$('#pbWait').addEventListener('click',function(){pbLocked=false;this.classList.add('sel');$('#pbLock').classList.remove('sel');renderPB()});
$('#pbLock').addEventListener('click',function(){pbLocked=true;this.classList.add('sel');$('#pbWait').classList.remove('sel');renderPB()});
renderPB();

/* ============ CASE LIBRARY ============ */
var caseMode='xe';
function renderCaseChips(){
  var vals={};
  $$('.ccard').forEach(function(c){var v=caseMode==='xe'?c.dataset.xe:c.dataset.pos;vals[v]=1});
  var html='<span class="fl">'+(caseMode==='xe'?'Xe:':'Vị trí:')+'</span><button class="chip sel" data-cv="all">Tất cả</button>';
  Object.keys(vals).forEach(function(v){html+='<button class="chip" data-cv="'+v+'">'+v+'</button>'});
  $('#caseChips').innerHTML=html;
  $$('#caseChips .chip').forEach(function(c){
    c.addEventListener('click',function(){
      $$('#caseChips .chip').forEach(function(x){x.classList.remove('sel')});
      c.classList.add('sel');
      var v=c.dataset.cv;
      $$('.ccard').forEach(function(cd){
        var val=caseMode==='xe'?cd.dataset.xe:cd.dataset.pos;
        cd.style.display=(v==='all'||val===v)?'':'none';
      });
    });
  });
}
$('#cvXe').addEventListener('click',function(){caseMode='xe';this.classList.add('on');$('#cvPos').classList.remove('on');renderCaseChips()});
$('#cvPos').addEventListener('click',function(){caseMode='pos';this.classList.add('on');$('#cvXe').classList.remove('on');renderCaseChips()});
renderCaseChips();

/* ============ BOOKING ============ */
$$('#regChips .chip').forEach(function(c){
  c.addEventListener('click',function(){
    $$('#regChips .chip').forEach(function(x){x.classList.remove('sel')});
    c.classList.add('sel');
    var r=c.dataset.reg;
    $$('.br').forEach(function(b){b.style.display=(r==='all'||b.dataset.reg===r)?'':'none'});
  });
});
$('#bkUpl').addEventListener('change',function(){$('#uplBox').classList.toggle('show',this.checked)});
$('#bkForm').addEventListener('submit',function(e){e.preventDefault();$('#bkToast').classList.add('show')});

/* ============ DEMO CONTROLS (M18 — trải nghiệm theo nguồn traffic) ============ */
$('#dcBtn').addEventListener('click',function(){$('#dcMenu').classList.toggle('show')});
function ctx(msg){var b=$('#ctxBanner');if(msg){b.innerHTML=msg;b.classList.add('show')}else{b.classList.remove('show')}}
function clearHl(){$$('.pcard,.ccard').forEach(function(x){x.classList.remove('hl')})}
function demoAction(k){
  clearHl();
  if(k==='seo'){ctx('Mô phỏng SEO: khách vào từ truy vấn "đèn gầm dạng rời ô tô" — thấy định nghĩa, BeamMatch, sản phẩm, giá, công nghệ, case theo đúng thứ tự.');window.scrollTo({top:0,behavior:'smooth'})}
  if(k==='ads'){ctx('Mô phỏng Google Ads · ?model=xlight-f30-ultra — F30 Ultra chọn sẵn trong Price Builder, card được đánh dấu. CTA: "Kiểm tra F30 lắp ở đâu trên xe tôi".');$('#pc-f30').classList.add('hl');$('#pbSelect').value='f30';renderPB();$('#pc-f30').scrollIntoView({behavior:'smooth',block:'center'})}
  if(k==='fb'){ctx('Mô phỏng Facebook · ?case=vf8-m30-ultra-v2 — mở thẳng case VinFast VF8, ảnh trước/sau, vị trí cản trước, CTA tải ảnh xe.');hlCase('cs-vf8');document.getElementById('cs-vf8').scrollIntoView({behavior:'smooth',block:'center'})}
  if(k==='return'){ctx('Mô phỏng khách quay lại — cấu hình cũ được giữ, mời tiếp tục thay vì làm lại từ đầu.');$('#bmResume').classList.add('show');document.getElementById('beammatch').scrollIntoView({behavior:'smooth'})}
  if(k==='reset'){ctx(null);$('#bmResume').classList.remove('show')}
  $('#dcMenu').classList.remove('show');
}
$$('#dcMenu button').forEach(function(b){b.addEventListener('click',function(){demoAction(b.dataset.dc)})});
$('#bmResumeBtn').addEventListener('click',function(){
  bmState={1:'tinh',2:'canbang',3:'bienso'};
  $$('.opt').forEach(function(o){o.classList.toggle('sel',bmState[o.dataset.step]===o.dataset.val)});
  $('#fHang').value='Ford';$('#fDong').value='EcoSport';
  showStep(4);
  $('#bmCard').scrollIntoView({behavior:'smooth'});
});
/* URL params → same handlers */
(function(){
  var q=new URLSearchParams(location.search);
  if(q.get('model')==='xlight-f30-ultra')demoAction('ads');
  if((q.get('case')||'').indexOf('vf8')>-1)demoAction('fb');
})();
</script>
</body>
</html>
