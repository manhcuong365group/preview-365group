# Cloudflare Pages headers
# preview-365group.pages.dev là môi trường PREVIEW — chặn index toàn site.
# KHÔNG copy file này sang production auto365.vn.
/*
  X-Robots-Tag: noindex, nofollow

# HTML luôn revalidate — tránh webview/zone cache giữ bản cũ
/phim-cach-nhiet-3m/*
  Cache-Control: no-cache, must-revalidate

/bi-gam
  Cache-Control: no-cache, must-revalidate
/bi-gam.html
  Cache-Control: no-cache, must-revalidate
